+# -- the second pass: a read the first pass missed is looked at again around its anchor --------
+
+
+class _MissesFirstPass(_BlockModel):
+    """Answers nothing for the first ``misses`` calls (the batches), then names its blocks."""
+
+    def __init__(self, blocks: List[Tuple[str, str]], text: str) -> None:
+        super().__init__(blocks)
+        self.misses = len(batches(split_units(text)))
+
+    def __call__(self, system: str, user: str) -> Optional[str]:
+        if self.calls < self.misses:
+            self.calls += 1
+            return json.dumps({"ads": []})
+        return super().__call__(system, user)
+
+
+def test_a_read_the_first_pass_missed_is_caught_around_its_anchor() -> None:
+    text = _episode([_TALK] * 120, _PITCH, [_TALK] * 120)
+    model = _MissesFirstPass([(_PITCH[0], _PITCH[-1])], text)
+    out = clean_by_selection(text, model, provider="fake")
+    assert "Mercury" not in out and "spin" not in out
+    assert out.count(_TALK) == 240
+
+
+def test_a_second_pass_block_must_cover_the_anchor() -> None:
+    reads = ["Notes are at the show page, see you next week.", "Go to acme.com slash river."]
+    text = _episode([_TALK] * 120, reads[:1], [_TALK] * 3, reads[1:], [_TALK] * 120)
+    model = _MissesFirstPass([(reads[0], reads[0])], text)  # a block that is not the anchor
+    _, remove = select_removals(text, model, provider="fake")
+    assert remove == set()
+
+
+def test_conversation_about_the_dot_com_bubble_is_no_anchor() -> None:
+    text = _episode(
+        ["It was very like the dot com bubble, and Pets.com went under."] * 3, [_TALK] * 50
+    )
+    model = _BlockModel([])
+    select_removals(text, model, provider="fake")
+    assert model.calls == len(batches(split_units(text))), "no second-pass call"
+
+
+def test_the_second_pass_is_capped_per_episode() -> None:
+    parts: List[List[str]] = []
+    for k in range(MAX_FOCUS_CALLS + 5):
+        parts += [[_TALK] * 60, [f"Go to brand{k}.com slash show."]]
+    text = _episode(*parts)
+    model = _BlockModel([])
+    select_removals(text, model, provider="fake")
+    assert model.calls == len(batches(split_units(text))) + MAX_FOCUS_CALLS
