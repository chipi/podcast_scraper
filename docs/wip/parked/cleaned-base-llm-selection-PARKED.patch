diff --git a/tests/unit/podcast_scraper/cleaning/test_span_selection.py b/tests/unit/podcast_scraper/cleaning/test_span_selection.py
new file mode 100644
index 000000000..a867b810d
--- /dev/null
+++ b/tests/unit/podcast_scraper/cleaning/test_span_selection.py
@@ -0,0 +1,462 @@
+"""Cleaning by selection: the cleaned transcript is the original minus whole sentences (#2276).
+
+The cleaning model used to return the transcript rewritten; these pin that the rebuilt text can
+only ever contain what was said, and that the model's ad BLOCKS are checked before anything is
+cut. The block cases are the failures seen on a 10-episode prod sample (2026-10-05), rebuilt from
+synthetic text.
+"""
+
+import json
+from typing import List, Optional, Tuple
+
+import pytest
+
+from podcast_scraper.cleaning.span_selection import (
+    apply_removals,
+    batches,
+    block_rejection,
+    clean_by_selection,
+    MAX_BLOCK_WORDS,
+    MAX_FOCUS_CALLS,
+    numbered,
+    parse_blocks,
+    select_removals,
+    split_units,
+    strip_filler_words,
+    trim_block_end,
+)
+
+pytestmark = pytest.mark.unit
+
+SCREENPLAY = (
+    "Ana: Welcome back. Today we talk about river trade.\n"
+    "Ben: This episode is brought to you by Acme. Use code RIVER for 10% off.\n"
+    "Ana: So the ports moved north. Why did they move?\n"
+    "Ben: The river silted up over a decade."
+)
+
+
+@pytest.mark.parametrize(
+    "text",
+    [
+        SCREENPLAY,
+        'factor.Now, the tariffs."Yes" he said',
+        "no punctuation at all " * 50,
+        "  leading space. Trailing space.  \n\n Blank line above.",
+        "",
+    ],
+)
+def test_units_rebuild_the_exact_text(text: str) -> None:
+    assert "".join(u.sep + u.text for u in split_units(text)) == text
+
+
+def test_a_sentence_glued_to_the_next_without_a_space_is_still_two() -> None:
+    assert [u.text for u in split_units("factor.Now, the tariffs.")] == [
+        "factor.",
+        "Now, the tariffs.",
+    ]
+
+
+def test_unpunctuated_asr_is_cut_into_word_windows() -> None:
+    units = split_units(" ".join(f"w{i}" for i in range(130)))
+    assert [len(u.text.split()) for u in units] == [40, 40, 40, 10]
+
+
+def test_removed_sentences_are_gone_and_everything_else_is_verbatim() -> None:
+    units = split_units(SCREENPLAY)
+    ad = {i for i, u in enumerate(units) if "Acme" in u.text or "RIVER" in u.text}
+    out = apply_removals(units, ad)
+    assert "Acme" not in out and "RIVER" not in out
+    kept = [u.text for i, u in enumerate(units) if i not in ad]
+    assert all(k in out for k in kept)
+    assert out.split("\n")[0] == "Ana: Welcome back. Today we talk about river trade."
+    assert len(out.split("\n")) == 3, "Ben's line was all ad, so it is gone; the rest stay lines"
+
+
+def test_removing_a_lines_first_sentence_keeps_its_speaker_label() -> None:
+    units = split_units("Ana: Hi.\nBen: Brought to you by Acme. Anyway, the river silted up.")
+    first_of_ben = next(i for i, u in enumerate(units) if "Acme" in u.text)
+    out = apply_removals(units, {first_of_ben})
+    assert out == "Ana: Hi.\nBen: Anyway, the river silted up."
+
+
+def test_a_line_whose_every_sentence_is_removed_disappears() -> None:
+    units = split_units("A: Real point.\nB: Buy Acme.\nA: Next point.")
+    out = apply_removals(units, {1})
+    assert out == "A: Real point.\nA: Next point."
+
+
+def test_batches_respect_the_word_budget_and_overlap() -> None:
+    units = split_units(" ".join(f"Sentence {i} is here." for i in range(100)))
+    groups = batches(units, max_words=40, overlap_words=8)
+    assert all(sum(len(units[i].text.split()) for i in g) <= 40 for g in groups)
+    assert sorted({i for g in groups for i in g}) == [i for i, u in enumerate(units) if u.text]
+    for a, b in zip(groups, groups[1:]):
+        assert a[-2:] == b[:2], "each batch repeats the last 8 words (two sentences) before it"
+
+
+def test_the_model_sees_global_numbers() -> None:
+    units = split_units("First. Second. Third.")
+    assert numbered(units, [1, 2]) == "[1] Second.\n[2] Third."
+
+
+def test_only_hesitation_sounds_are_stripped() -> None:
+    assert (
+        strip_filler_words("Um, so I think, uh, the river moved.") == "so I think, the river moved."
+    )
+    kept = "Umbrella sales rose. I like it, you know, I mean really."
+    assert strip_filler_words(kept) == kept
+
+
+def _ad_units():
+    return split_units(
+        "Ana: Welcome back. This episode is brought to you by Acme. Acme makes boats. "
+        "Use code RIVER today. So the ports moved north. The river silted up."
+    )
+
+
+def _end(n: int, words: str) -> dict:
+    return {"n": n, "first_words": words}
+
+
+def _reply(*blocks: Tuple[int, str, int, str]) -> str:
+    return json.dumps(
+        {"ads": [{"start": _end(a, aw), "end": _end(b, bw)} for a, aw, b, bw in blocks]}
+    )
+
+
+def test_a_block_is_named_by_both_ends_vouched_for_by_their_words() -> None:
+    units = _ad_units()
+    batch = list(range(len(units)))
+    reply = _reply((1, "This episode is", 3, "Use code RIVER"))
+    assert parse_blocks(reply, batch, units) == [(1, 3)]
+
+
+def test_an_end_that_drifted_by_one_is_found_by_its_words() -> None:
+    units = _ad_units()
+    batch = list(range(len(units)))
+    # The model counted one short at both ends.
+    assert parse_blocks(_reply((0, "This episode is", 2, "Use code RIVER")), batch, units) == [
+        (1, 3)
+    ]
+
+
+@pytest.mark.parametrize(
+    "reply",
+    [
+        _reply((1, "So the ports", 3, "Use code RIVER")),  # an end not vouched for
+        _reply((3, "Use code RIVER", 1, "This episode is")),  # ends reversed
+        json.dumps({"ads": [{"start": _end(1, "This episode is")}]}),  # no end
+        json.dumps({"ads": [[1, 3]]}),  # bare numbers cannot be checked
+    ],
+)
+def test_a_block_whose_ends_cannot_be_checked_is_dropped(reply: str) -> None:
+    units = _ad_units()
+    assert parse_blocks(reply, list(range(len(units))), units) == []
+
+
+def test_an_unusable_reply_is_none_and_an_empty_one_is_no_blocks() -> None:
+    units = _ad_units()
+    batch = list(range(len(units)))
+    assert parse_blocks("I removed the ads.", batch, units) is None
+    assert parse_blocks('{"remove": [1]}', batch, units) is None
+    assert parse_blocks('Sure! {"ads": []}', batch, units) == []
+
+
+def test_an_end_outside_the_batch_does_not_count() -> None:
+    units = _ad_units()
+    assert parse_blocks(_reply((1, "This episode is", 3, "Use code RIVER")), [0, 1, 2], units) == []
+
+
+# -- the block rules, on the failures from the prod sample ---------------------------------------
+
+_TALK = "So the ports moved north over a decade, and the trading families followed the water."
+#: Mercury-like: the read names the sponsor once, then pitches for many sentences.
+_PITCH = [
+    "This show is presented by Mercury.",
+    "I've trusted Mercury for my banking for the last several years.",
+    "They have a new feature, which is an assistant embedded in your banking interface.",
+    "I took it out for a spin and it handled the transfer in seconds.",
+    "That's why over 300,000 businesses use them.",
+    "Visit mercury.com to learn more and apply online in minutes.",
+]
+_PITCH2 = [
+    "Support for the show comes from MongoDB.",
+    "If your data layer is a bottleneck, what's the point?",
+    "MongoDB gets out of your way.",
+    "Start building at mongodb.com slash AI.",
+]
+#: Hard Fork-like: a show opening the model once returned as a block. No promo signal anywhere.
+_OPENING = [
+    "I'm Kevin, the tech columnist at the paper.",
+    "And this is the show.",
+    "This week, the most iconic technologies of the year.",
+    "It's a countdown that you won't want to miss.",
+    "Listeners may remember that last year we debuted the list.",
+    "It became our most popular episode of the year.",
+]
+#: A countdown with one URL in the middle: conversation, even though a URL is said. (Hard Fork:
+#: the misread block ran 40 sentences with the URL at the 13th.) A SHORT stretch with a URL near
+#: its edge would pass the signal rule; the prompt is what keeps the model from naming it.
+_COUNTDOWN = [
+    "Number 20, video podcasts.",
+    "Everyone has a camera on now.",
+    "It changed how shows get made.",
+    "Guests now ask what to wear.",
+    "Some of them only watch.",
+    "People watch us on the website, and they can go to youtube.com slash ours.",
+    "It is a strange new habit.",
+    "Number 19, chat servers.",
+    "They took over every community this year.",
+    "Even our families are on one.",
+    "Moderation is the hard part.",
+    "Nobody planned for that.",
+]
+
+
+def _episode(*parts: List[str]) -> str:
+    lines = []
+    for part in parts:
+        lines.extend(part)
+    return "\n".join(f"Host: {line}" for line in lines)
+
+
+def _index(units, text: str) -> int:
+    return next(i for i, u in enumerate(units) if text in u.text)
+
+
+def test_a_named_read_goes_whole_pitch_and_all() -> None:
+    units = split_units(_episode([_TALK] * 30, _PITCH, [_TALK] * 30))
+    a, b = _index(units, _PITCH[0]), _index(units, _PITCH[-1])
+    assert block_rejection(units, a, b) is None
+
+
+def test_a_show_opening_has_no_promo_signal_and_stays() -> None:
+    units = split_units(_episode(_OPENING, [_TALK] * 30))
+    a, b = _index(units, _OPENING[0]), _index(units, _OPENING[-1])
+    assert (
+        block_rejection(units, a, b) == "no sponsor, promotion or housekeeping signal at either end"
+    )
+
+
+def test_a_url_in_the_middle_of_conversation_does_not_make_it_an_ad() -> None:
+    units = split_units(_episode([_TALK] * 5, _COUNTDOWN, [_TALK] * 5))
+    a, b = _index(units, _COUNTDOWN[0]), _index(units, _COUNTDOWN[-1])
+    assert block_rejection(units, a, b) is not None
+
+
+@pytest.mark.parametrize(
+    "line",
+    [
+        "That's it for today's episode of the show. See you next time.",
+        "Thanks for listening to the show, a production of the paper.",
+        "And we'll see you next week.",
+    ],
+)
+def test_a_sign_off_is_housekeeping(line: str) -> None:
+    units = split_units(_episode([_TALK] * 5, [line]))
+    i = _index(units, line.split(".")[0])
+    assert block_rejection(units, i, len(units) - 1) is None
+
+
+def test_a_block_longer_than_any_ad_read_stays() -> None:
+    units = split_units(_episode(_PITCH[:1], [_TALK] * 60, _PITCH[-1:]))
+    a, b = _index(units, _PITCH[0]), _index(units, _PITCH[-1])
+    assert sum(len(units[i].text.split()) for i in range(a, b + 1)) > MAX_BLOCK_WORDS
+    assert block_rejection(units, a, b) == "too long for an ad read"
+
+
+class _BlockModel:
+    """Answers with the blocks it is told, wherever both ends are in the batch it sees."""
+
+    def __init__(self, blocks: List[Tuple[str, str]]) -> None:
+        self.blocks = blocks
+        self.calls = 0
+
+    def __call__(self, system: str, user: str) -> Optional[str]:
+        self.calls += 1
+        lines = {
+            int(n): t
+            for n, t in (ln[1:].split("] ", 1) for ln in user.splitlines() if ln.startswith("["))
+        }
+        out = []
+        for first, last in self.blocks:
+            a = next((n for n, t in lines.items() if first in t), None)
+            b = next((n for n, t in lines.items() if last in t), None)
+            if a is not None and b is not None:
+                out.append(
+                    {
+                        "start": _end(a, " ".join(lines[a].split()[:3])),
+                        "end": _end(b, " ".join(lines[b].split()[:3])),
+                    }
+                )
+        return json.dumps({"ads": out})
+
+
+def test_two_reads_back_to_back_are_both_removed() -> None:
+    """The e3 case: two reads filled 57% of a batch and the old per-batch guard kept them."""
+    text = _episode([_TALK] * 10, _PITCH, _PITCH2, [_TALK] * 10)
+    model = _BlockModel([(_PITCH[0], _PITCH[-1]), (_PITCH2[0], _PITCH2[-1])])
+    out = clean_by_selection(text, model, provider="fake")
+    assert "Mercury" not in out and "MongoDB" not in out and "bottleneck" not in out
+    assert out.count(_TALK) == 20
