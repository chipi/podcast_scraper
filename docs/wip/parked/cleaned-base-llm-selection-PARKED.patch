+# -- the end trim: every wrong cut on the prod sample was one sentence past the read -------------
+
+
+def _lines(*pairs: Tuple[str, str]) -> str:
+    return "\n".join(f"{who}: {what}" for who, what in pairs)
+
+
+def test_the_next_speaker_taking_the_floor_back_is_not_part_of_the_read() -> None:
+    units = split_units(
+        _lines(
+            ("Kevin", _TALK),
+            ("Jon", "I run the games team at the paper."),
+            ("Jon", "If you think so too, download our games app today."),
