diff --git a/tests/unit/podcast_scraper/workflow/test_adfree_llm_selection.py b/tests/unit/podcast_scraper/workflow/test_adfree_llm_selection.py
new file mode 100644
index 000000000..b3e05d142
--- /dev/null
+++ b/tests/unit/podcast_scraper/workflow/test_adfree_llm_selection.py
@@ -0,0 +1,225 @@
+"""The ad-free base is refined by the LLM selection pass, once, in place (#2276).
+
+The rules that build the base only cut pre-roll / post-roll; a mid-roll sponsor read survives
+them. The selection pass names the sponsor SENTENCES, the segments inside them are cut, and the
+base is rebuilt with exact offsets for every consumer. Synthetic episodes; the model is a fake
+that answers the selection prompt the way a correct model would.
+"""
+
+from __future__ import annotations
+
+import json
+import re
+from pathlib import Path
+from typing import List, Optional
+
+import pytest
+
+from podcast_scraper.providers.ml.diarization.formatting import (
+    format_diarized_screenplay_with_offsets,
+)
+from podcast_scraper.workflow.adfree_transcript import (
+    LLM_SELECTION_KEY,
+    load_processing_transcript,
+    produce_adfree_transcript,
+    refine_adfree_with_selection,
+)
+
+pytestmark = pytest.mark.unit
+
+_MIDROLL = [
+    "This episode is brought to you by Acme Boats.",
+    "Acme makes the fastest boats on the river.",
+    "Use code RIVER at acme dot com for ten percent off.",
+]
+_TALK = [
+    "So the ports moved north over a decade.",
+    "Why did they move so far?",
+    "The delta silted up and the big ships could not reach the old docks.",
+    "That changed every trading family in the city.",
+]
+
+
+def _segments() -> List[dict]:
+    lines = _TALK * 3 + _MIDROLL + _TALK * 3
+    segs, t = [], 0.0
+    for i, line in enumerate(lines):
+        segs.append(
+            {"start": t, "end": t + 2.0, "text": line, "speaker_label": "Ana" if i % 2 else "Ben"}
+        )
+        t += 2.0
+    return segs
+
+
+def _write_episode(tmp_path: Path) -> str:
+    segs = _segments()
+    text, _ = format_diarized_screenplay_with_offsets(segs)
+    rel = "transcripts/0001 - ep.txt"
+    (tmp_path / "transcripts").mkdir()
+    (tmp_path / rel).write_text(text)
+    assert produce_adfree_transcript(text, segs, rel, str(tmp_path))
+    return rel
+
+
+class _Model:
+    """Names the sponsor read as one block, both ends with their first words, like a correct
+    model."""
+
+    def __init__(self) -> None:
+        self.calls = 0
+
+    def __call__(self, system: str, user: str) -> Optional[str]:
+        self.calls += 1
+        ends = [
+            {"n": int(m.group(1)), "first_words": " ".join(m.group(2).split()[:3])}
+            for m in re.finditer(r"^\[(\d+)\] (.*)$", user, re.MULTILINE)
+            if "acme" in m.group(2).lower() or "brought to you" in m.group(2)
+        ]
+        blocks = [{"start": ends[0], "end": ends[-1]}] if ends else []
+        return json.dumps({"ads": blocks})
+
+
+def test_the_rules_leave_a_midroll_read_in_the_base(tmp_path: Path) -> None:
+    rel = _write_episode(tmp_path)
+    assert "brought to you by Acme" in load_processing_transcript(str(tmp_path), rel).text
+
+
+def test_the_selection_pass_cuts_the_midroll_and_keeps_offsets_exact(tmp_path: Path) -> None:
+    rel = _write_episode(tmp_path)
+    before = load_processing_transcript(str(tmp_path), rel).text
+    record = refine_adfree_with_selection(str(tmp_path), rel, _Model(), provider="fake")
+    base = load_processing_transcript(str(tmp_path), rel)
+    assert "Acme" not in base.text and "RIVER" not in base.text
+    assert all(t in base.text for t in _TALK), "the conversation is untouched"
+    assert base.segments is not None and base.ad_map is not None
+    assert all(base.text[s["char_start"] : s["char_end"]] == s["text"] for s in base.segments)
+    assert record is not None and record["sentences_removed"] == 3
+    assert [c["text"] for c in record["cut_segments"]] == _MIDROLL
+    assert record["chars_removed"] == len(before) - len(base.text)
+    assert base.ad_map[LLM_SELECTION_KEY] == record
+    assert "Ben:" in base.text and "Ana:" in base.text, "speaker turns are re-rendered"
+
+
+def test_the_pass_runs_once(tmp_path: Path) -> None:
+    rel = _write_episode(tmp_path)
+    model = _Model()
+    first = refine_adfree_with_selection(str(tmp_path), rel, model)
+    calls = model.calls
+    again = refine_adfree_with_selection(str(tmp_path), rel, model)
+    assert again == first and model.calls == calls, "a re-run does not select or cut twice"
+
+
+def test_a_model_that_answers_nothing_usable_cuts_nothing(tmp_path: Path) -> None:
+    rel = _write_episode(tmp_path)
+    before = load_processing_transcript(str(tmp_path), rel).text
+    record = refine_adfree_with_selection(str(tmp_path), rel, lambda s, u: "I removed the ads.")
+    assert record is not None and record["cut_segments"] == []
+    assert load_processing_transcript(str(tmp_path), rel).text == before
+
+
+def test_unpunctuated_asr_is_recorded_and_not_cut(tmp_path: Path) -> None:
+    segs = [
+        {
+            "start": float(i),
+            "end": i + 1.0,
+            "text": "so the ports moved north and",
+            "speaker_label": "Ana",
+        }
+        for i in range(80)
+    ]
+    text, _ = format_diarized_screenplay_with_offsets(segs)
+    rel = "transcripts/0002 - asr.txt"
+    (tmp_path / "transcripts").mkdir()
+    (tmp_path / rel).write_text(text)
+    produce_adfree_transcript(text, segs, rel, str(tmp_path))
+    model = _Model()
+    record = refine_adfree_with_selection(str(tmp_path), rel, model)
+    assert record is not None and record["skipped"] == "unpunctuated" and model.calls == 0
+
+
+def test_no_adfree_base_is_left_alone(tmp_path: Path) -> None:
+    assert refine_adfree_with_selection(str(tmp_path), "transcripts/none.txt", _Model()) is None
+
+
+def _summarize_with(tmp_path: Path, rel: str, *, on: bool):
+    from unittest.mock import Mock
+
+    from podcast_scraper import config
+    from podcast_scraper.cleaning import HybridCleaner
+    from podcast_scraper.workflow.metadata_generation import _generate_episode_summary
+
+    cfg = config.Config.model_validate(
+        dict(
+            rss="https://example.com/feed.xml",
+            generate_summaries=True,
+            generate_metadata=True,
+            summary_provider="transformers",
+            save_cleaned_transcript=False,
+            cleaned_base_llm_selection=on,
+        )
+    )
+    provider = Mock()
+    provider.summarize.return_value = {
+        "summary": '{"title": "T", "bullets": ["One", "Two"]}',
+        "summary_short": None,
+        "metadata": {"model": "m"},
+    }
+    provider.cleaning_processor = HybridCleaner()
+    provider.clean_transcript.side_effect = lambda text, **kw: text
+    _generate_episode_summary(
+        transcript_file_path=rel,
+        output_dir=str(tmp_path),
+        cfg=cfg,
+        episode_idx=1,
+        summary_provider=provider,
+        pipeline_metrics=None,
+    )
+    return provider
+
+
+def test_with_the_cleaned_base_the_summary_reads_it_and_does_not_clean_again(
+    tmp_path: Path,
+) -> None:
+    rel = _write_episode(tmp_path)
