+def test_a_read_across_a_batch_edge_is_seen_whole_by_the_overlap() -> None:
+    talk = [f"Point {i} is about the river trade and the ports." for i in range(70)]
+    text = _episode(talk, _PITCH, talk)
+    units = split_units(text)
+    a, b = _index(units, _PITCH[0]), _index(units, _PITCH[-1])
+    assert not any(a in g and b in g for g in batches(units, overlap_words=0)), "precondition"
+    assert any(a in g and b in g for g in batches(units)), "one batch holds the whole read"
+    _, remove = select_removals(text, _BlockModel([(_PITCH[0], _PITCH[-1])]), provider="fake")
+    assert remove == set(range(a, b + 1))
