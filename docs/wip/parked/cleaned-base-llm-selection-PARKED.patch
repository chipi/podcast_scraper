@@ -0,0 +1,504 @@
+"""Transcript cleaning by SELECTION, never by generation (#2276).
+
+The cleaning model used to be asked for the whole transcript back, "cleaned". It rewrote it: on a
+400-episode prod sample the median cleaned transcript held 5.6% words the speakers never said
+(fillers, case and punctuation excluded), 12% of episodes over 20%, with paraphrase ("makes it
+virtually impossible" -> "hard") and invented connective sentences ("This convergence
+underscores..."). That text feeds the summary.
+
+Here the model only sees the transcript as numbered units (sentences, line structure kept) and
+answers with BLOCKS to drop -- sponsor reads, promotion, show housekeeping -- each named by its
+first and last sentence. The cleaned transcript is rebuilt from the original units, so every word
+in it was spoken: the model cannot paraphrase, summarise or invent because it never writes text.
+Filler WORDS inside a sentence ("um", "uh") are removed by a fixed rule, not by the model.
+
+Blocks, not single sentences: asked sentence by sentence, the model named the line that names the
+sponsor and left the pitch after it (Mercury, MongoDB, IG, Vauxhall on a 10-episode prod sample,
+2026-10-05), and on a re-run cut the 40-sentence opening of a Hard Fork episode. A block is kept
+only when both ends are vouched for by their first words, a promo signal sits at one of its ends,
+and it is short enough to be an ad (see ``block_rejection``).
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import re
+from dataclasses import dataclass
+from typing import Callable, Iterable, List, Optional, Sequence, Set, Tuple
+
+logger = logging.getLogger(__name__)
+
+#: A unit is a sentence: it ends at . ! ? followed by whitespace, or directly by a capital
+#: ("factor.Now," -- publisher transcripts that drop the space), never across a line break.
+_SENTENCE_END = re.compile(r"(?<=[.!?])(?:(\s+)|(?=[A-Z\u201c\"]))")
+#: Lowercase, unpunctuated ASR has no sentences at all (a 49k-char DeepMind episode came out as
+#: two "sentences"); a unit longer than this is cut into word windows so the model can still
+#: point at an ad without taking the episode with it.
+MAX_UNIT_WORDS = 60
+_WINDOW_WORDS = 40
+_TOKEN = re.compile(r"\S+\s*")
+#: A batch the model labels in one call. Small on purpose: on a 171-sentence batch Qwen3-30B listed
+#: the sponsor read correctly, then ran on counting 42, 43, 44... to the last sentence.
+DEFAULT_BATCH_WORDS = 800
+#: Consecutive batches share this many words, so a read that crosses a batch edge is seen whole
+#: by one of them.
+BATCH_OVERLAP_WORDS = 150
+#: The longest block that can be an ad read. The longest single read on the prod sample was ~300
+#: words (Mercury, Complex Systems); two reads back to back fit too.
+MAX_BLOCK_WORDS = 600
+#: A promo signal must sit in this many sentences at either end of a block: a read opens on the
+#: sponsor ("brought to you by") or closes on the call to action (URL, code).
+SIGNAL_EDGE_UNITS = 3
+#: Selections that would drop more than this share of an episode's words are not ad removal; the
+#: episode is left as it was.
+MAX_EPISODE_SHARE = 0.3
+#: At most this many sentences are trimmed off a block's end (see ``trim_block_end``).
+MAX_END_TRIM = 2
+#: The second pass looks again at this many sentences either side of a strong ad anchor the first
+#: pass left in, and makes at most ``MAX_FOCUS_CALLS`` such calls per episode.
+FOCUS_RADIUS_UNITS = 25
+MAX_FOCUS_CALLS = 12
+#: Hesitation sounds only. "like", "you know", "I mean" carry meaning often enough to stay.
+_FILLER_WORD = re.compile(r"(?<![\w'])(?:um+|uh+|uhm|erm)(?![\w'])[,.]?[ \t]*", re.IGNORECASE)
+
+
+@dataclass(frozen=True)
+class Unit:
+    """One sentence of the transcript, with the whitespace that preceded it."""
+
+    sep: str
+    text: str
+
+
+def _sentences(line: str) -> List[tuple]:
+    """``[(sep_before, sentence)]`` for one line, sep = the whitespace after the previous end."""
+    out: List[tuple] = []
+    start = 0
+    sep = ""
+    for m in _SENTENCE_END.finditer(line):
+        if m.start() > start:
+            out.append((sep, line[start : m.start()]))
+            sep = m.group(1) or ""
+            start = m.end()
+    out.append((sep, line[start:]))
+    return out
+
+
+def _windows(sentence: str) -> List[tuple]:
+    """A sentence over ``MAX_UNIT_WORDS`` words as ~``_WINDOW_WORDS``-word pieces."""
+    toks = _TOKEN.findall(sentence)
+    if len(toks) <= MAX_UNIT_WORDS:
+        return [("", sentence)]
+    pieces = []
+    for k in range(0, len(toks), _WINDOW_WORDS):
+        chunk = "".join(toks[k : k + _WINDOW_WORDS])
+        body = chunk.rstrip()
+        pieces.append((body, chunk[len(body) :]))
+    out: List[tuple] = []
+    carry = ""
+    for body, trail in pieces:
+        out.append((carry, body))
+        carry = trail
+    if carry:
+        out[-1] = (out[-1][0], out[-1][1] + carry)
+    return out
+
+
+def split_units(text: str) -> List[Unit]:
+    """Sentences (or word windows) in order; ``"".join(u.sep + u.text for u in units) == text``."""
+    units: List[Unit] = []
+    pending_sep = ""
+    for li, line in enumerate(text.split("\n")):
+        if li:
+            pending_sep += "\n"
+        for sep, sentence in _sentences(line):
+            pending_sep += sep
+            if sentence == "":
+                continue
+            for wsep, piece in _windows(sentence):
+                units.append(Unit(pending_sep + wsep, piece))
+                pending_sep = ""
+    if pending_sep:
+        units.append(Unit(pending_sep, ""))
+    return units
+
+
+def batches(
+    units: Sequence[Unit],
+    max_words: int = DEFAULT_BATCH_WORDS,
+    overlap_words: int = BATCH_OVERLAP_WORDS,
+) -> List[List[int]]:
+    """Unit indices in groups of at most ``max_words`` words (a longer unit stands alone); each
+    group after the first repeats the last ``overlap_words`` words of the one before it."""
+    words = [(i, len(u.text.split())) for i, u in enumerate(units) if u.text.split()]
+    out: List[List[int]] = []
+    k = 0
+    while k < len(words):
+        cur: List[int] = []
+        total = 0
+        j = k
+        while j < len(words) and (not cur or total + words[j][1] <= max_words):
+            cur.append(words[j][0])
+            total += words[j][1]
+            j += 1
+        out.append(cur)
+        if j >= len(words):
+            break
+        back, carried = j, 0
+        while back - 1 > k and carried + words[back - 1][1] <= overlap_words:
+            back -= 1
+            carried += words[back][1]
+        k = back
+    return out
+
+
+def numbered(units: Sequence[Unit], indices: Iterable[int]) -> str:
+    """The batch as the model sees it: one ``[n] sentence`` per line, n = global unit index."""
+    return "\n".join(f"[{i}] {units[i].text.strip()}" for i in indices)
+
+
+def _words(text: str) -> List[str]:
+    return re.findall(r"[a-z0-9']+", text.lower().replace("\u2019", "'"))
+
+
+def _vouched(unit_text: str, first_words: str) -> bool:
+    """Does the sentence open with the words the model quoted for it (speaker label skipped)?"""
+    said = _words(first_words)[:3]
+    if not said:
+        return False
+    body = _SPEAKER_LABEL.sub("", unit_text.strip(), count=1)
+    return _words(body)[: len(said)] == said or _words(unit_text)[: len(said)] == said
+
+
+def _resolve(end: object, ok: Set[int], units: Sequence[Unit]) -> Optional[int]:
+    """The unit an ``{"n", "first_words"}`` end names. The QUOTED WORDS are the key and the number
+    a hint: the model drifts by one or two when it counts (it named sentence 26 "25" on a Lenny's
+    Podcast sponsor read)."""
+    if not isinstance(end, dict):
+        return None
+    n, quoted = end.get("n"), end.get("first_words")
+    if not isinstance(n, int) or isinstance(n, bool) or not isinstance(quoted, str):
+        return None
+    for d in _NEAR:
+        k = n + d
+        if k in ok and _vouched(units[k].text, quoted):
+            return k
+    return None
+
+
+def parse_blocks(
+    raw: Optional[str], allowed: Iterable[int], units: Sequence[Unit]
+) -> Optional[List[Tuple[int, int]]]:
+    """The ``(first, last)`` unit of every block the reply names; ``None`` when it is unusable.
+
+    ``{"ads": [{"start": {"n": 12, "first_words": "This episode is"},
+    "end": {"n": 19, "first_words": "Use code RIVER"}}]}``. A block counts only when both ends
+    open with their quoted words, in order, inside this batch.
+    """
+    if not raw:
+        return None
+    m = re.search(r"\{.*\}", raw.strip(), re.DOTALL)
+    if not m:
+        return None
+    try:
+        data = json.loads(m.group(0))
+    except ValueError:
+        return None
+    items = data.get("ads") if isinstance(data, dict) else None
+    if not isinstance(items, list):
+        return None
+    ok = set(allowed)
+    out: List[Tuple[int, int]] = []
+    for it in items:
+        if not isinstance(it, dict):
+            continue
+        first = _resolve(it.get("start"), ok, units)
+        last = _resolve(it.get("end"), ok, units)
+        if first is not None and last is not None and first <= last:
+            out.append((first, last))
+    return out
+
+
+#: Where to look for the sentence a quoted opening belongs to, nearest first.
+_NEAR = (0, -1, 1, -2, 2, -3, 3)
+
+#: What an ad read, a promotion or show housekeeping says at its start or its end.
+_PROMO_SIGNAL = re.compile(
+    r"brought to you by|sponsored by|\bsponsors?\b|presented by|supported by"
+    r"|support for (?:this|the) (?:show|podcast|episode)"
+    r"|\bpromo code|\buse (?:the )?code\b|\bcode \w+ at checkout|percent off|\d+% off"
+    r"|\bwww\.|https?://|\b[\w-]+(?:\.| dot )(?:com|org|net|io|ai|fm|co|uk)\b|\bslash\b"
+    r"|\bsubscribe\b|\brating\b|\breview\b|wherever you get your podcasts|thanks for listening"
+    r"|that's it for today|see you next (?:time|week|episode)|until next time"
+    r"|produced by|edited by|executive producer|\bsound (?:editor|design)|music (?:is )?by"
+    r"|terms and conditions|t's and c's|capital is at risk|\bfdic\b",
+    re.IGNORECASE,
+)
+
+
+#: Strong evidence of an ad read: the sponsor line, a promo code, or a call to action with a URL.
+#: Narrower than ``_PROMO_SIGNAL`` -- "the dot com bubble" or "Pets.com" in conversation is not one.
+_AD_ANCHOR = re.compile(
+    r"brought to you by|sponsored by|presented by"
+    r"|support for (?:this|the) (?:show|podcast|episode) comes from"
+    r"|\b(?:promo|discount) code|\buse (?:the )?code\b"
+    r"|\b[\w-]+(?:\.| dot )(?:com|org|net|io|ai|fm|co)(?:/| slash | forward slash )\w"
+    r"|\b(?:go to|visit|head (?:over )?to|learn more at|try \w+ (?:for free )?at)\s+(?:www\.)?"
+    r"[\w-]+(?:\.| dot )(?:com|org|net|io|ai|fm|co)\b",
+    re.IGNORECASE,
+)
+
+
+def _line_label(units: Sequence[Unit], i: int) -> Optional[str]:
+    """The speaker label unit ``i`` opens its line with, or ``None`` when it continues a line."""
+    if i and "\n" not in units[i].sep:
+        return None
+    m = _SPEAKER_LABEL.match(units[i].text.strip())
+    return m.group(1) if m else None
+
+
+def _speaker_before(units: Sequence[Unit], i: int) -> Optional[str]:
+    for j in range(i - 1, -1, -1):
+        label = _line_label(units, j)
+        if label:
+            return label
+    return None
+
+
+def trim_block_end(units: Sequence[Unit], first: int, last: int) -> int:
+    """The block's last unit after dropping a conversation sentence the model ran on into.
+
+    On the prod sample every wrong cut was ONE sentence at a block's end: the next speaker taking
+    the floor back ("Kevin Roose: Well, Casey, ...") or the host turning to the guest right after
+    the call to action ("So, Milan, welcome to the podcast."). An end sentence with no promo
+    signal of its own is dropped when it opens a new speaker's line or follows a sentence that
+    carries the signal; at most ``MAX_END_TRIM`` sentences go this way.
+    """
+    for _ in range(MAX_END_TRIM):
+        if last <= first or _PROMO_SIGNAL.search(units[last].text):
+            break
+        label = _line_label(units, last)
+        new_speaker = label is not None and label != _speaker_before(units, last)
+        prev = max((j for j in range(first, last) if units[j].text.strip()), default=None)
+        after_signal = prev is not None and bool(_PROMO_SIGNAL.search(units[prev].text))
+        if not (new_speaker or after_signal):
+            break
+        last = prev if prev is not None else first
+    return last
+
+
+def block_rejection(units: Sequence[Unit], first: int, last: int) -> Optional[str]:
+    """Why a named block cannot be an ad read (``None`` when it can).
+
+    An ad is short and announces itself at an edge: it opens on the sponsor or closes on the call
+    to action. A stretch of conversation the model misread (a show opening, a countdown with one
+    URL in the middle) fails one of the two.
+    """
+    idx = [i for i in range(first, last + 1) if units[i].text.strip()]
+    if sum(len(units[i].text.split()) for i in idx) > MAX_BLOCK_WORDS:
+        return "too long for an ad read"
+    edges = idx[:SIGNAL_EDGE_UNITS] + idx[-SIGNAL_EDGE_UNITS:]
+    if not any(_PROMO_SIGNAL.search(units[i].text) for i in edges):
+        return "no sponsor, promotion or housekeeping signal at either end"
+    return None
+
+
+#: A screenplay line starts with its speaker: "Ana: ...", "SPEAKER_01: ...".
+_SPEAKER_LABEL = re.compile(r"^([^:\n.!?]{1,40}:)\s")
+
+
+def apply_removals(units: Sequence[Unit], remove: Set[int]) -> str:
+    """The original text without the removed units. A removed unit keeps a line break it carried,
+    and the speaker label it opened its line with, so the sentences left on that line keep their
+    speaker; a line left empty (or holding only its label) is dropped."""
+    pieces: List[str] = []
+    for i, u in enumerate(units):
+        if i not in remove:
+            pieces.append(u.sep + u.text)
+            continue
+        if "\n" in u.sep or i == 0:
+            label = _SPEAKER_LABEL.match(u.text)
+            pieces.append("\n" * u.sep.count("\n") + (label.group(1) if label else ""))
+    rebuilt = "".join(pieces)
+    lines = [ln.rstrip() for ln in rebuilt.split("\n")]
+    return "\n".join(ln for ln in lines if ln.strip() and not _LABEL_ONLY.match(ln))
+
+
+_LABEL_ONLY = re.compile(r"^\s*[^:\n.!?]{1,40}:\s*$")
+
+
+#: Sentence ends per 1,000 words below which a transcript is unpunctuated ASR. 5% of the prod
+#: corpus (120 of 2,358 episodes, 2026-10-05) is lowercase text with no punctuation at all.
+MIN_SENTENCE_ENDS_PER_1000_WORDS = 5.0
+
+
+def has_sentences(text: str) -> bool:
+    """Is there sentence punctuation to select by? Without it the units are 40-word windows that
+    mix a show intro with the topic or an ad with a story: on a DeepMind episode 2 of the 4
+    windows the model chose were conversation. Such a transcript is not cleaned by selection."""
+    words = len(text.split())
+    if not words:
+        return False
+    ends = len(re.findall(r"[.!?](?:\s|$|[A-Z])", text))
+    return ends * 1000 / words >= MIN_SENTENCE_ENDS_PER_1000_WORDS
+
+
+def strip_filler_words(text: str) -> str:
+    """Remove hesitation sounds ("um", "uh") with their trailing comma; nothing else."""
+    out = _FILLER_WORD.sub("", text)
+    return re.sub(r"[ \t]{2,}", " ", out)
+
+
+#: The system prompt every provider sends with the selection call.
+SELECTION_SYSTEM_PROMPT = (
+    "You label transcript sentences. You never write or rewrite transcript text. "
+    'Answer with JSON only: {"ads": [{"start": {"n": number, "first_words": "..."}, '
+    '"end": {"n": number, "first_words": "..."}}]}.'
+)
+#: The selection reply is a short list of blocks, two numbers + three words each: a small budget.
+SELECTION_MAX_TOKENS = 1024
+#: The shared selection prompt (``prompts/shared/cleaning/``); one template for every provider.
+SELECTION_PROMPT = "shared/cleaning/ad_blocks_v1"
+
+
+def _accept(
+    units: Sequence[Unit], first: int, last: int, provider: str
+) -> Optional[Tuple[int, int]]:
+    """The block as it is cut (end trimmed), or ``None`` when it cannot be an ad read."""
+    last = trim_block_end(units, first, last)
+    why = block_rejection(units, first, last)
+    if why:
+        logger.info(
+            "%s cleaning: block [%d..%d] kept (%s): %.80r",
+            provider,
+            first,
+            last,
+            why,
+            units[first].text.strip(),
+        )
+        return None
+    return first, last
+
+
+def _ask_blocks(
+    units: Sequence[Unit],
+    window: Sequence[int],
+    ask: Callable[[str, str], Optional[str]],
+    provider: str,
+) -> Optional[List[Tuple[int, int]]]:
+    from ..prompts.store import render_prompt
+
+    user_prompt = render_prompt(SELECTION_PROMPT, sentences=numbered(units, window), title=None)
+    reply = ask(SELECTION_SYSTEM_PROMPT, user_prompt)
+    blocks = parse_blocks(reply, window, units) if reply else None
+    if blocks is None:
+        logger.warning("%s cleaning: no usable selection reply; batch kept whole", provider)
+    return blocks
+
+
+def _missed_anchors(units: Sequence[Unit], remove: Set[int]) -> List[int]:
+    return [i for i, u in enumerate(units) if i not in remove and _AD_ANCHOR.search(u.text)]
+
+
+def select_removals(
+    text: str,
+    ask: Callable[[str, str], Optional[str]],
+    *,
+    provider: str = "",
+) -> Tuple[List[Unit], Set[int]]:
+    """The units of ``text`` and the ones to DROP: every unit of every accepted block.
+
+    First pass: every batch. Second pass: the model asked again, around each strong ad anchor the
+    first pass left in (on the prod sample whole reads were missed in one run and caught in the
+    other); a block from that pass counts only when it covers the anchor. Unpunctuated text is not
+    selected from (no removals). ``ask(system_prompt, user_prompt)`` is the provider's single
+    call: the raw reply, or ``None`` when there is nothing usable.
+    """
+    units = split_units(text)
+    if not has_sentences(text):
+        logger.info(
+            "%s cleaning: no sentence punctuation (unpunctuated ASR) -- nothing selected",
+            provider or "LLM",
+        )
+        return units, set()
+    remove: Set[int] = set()
+    for batch in batches(units):
+        for first, last in _ask_blocks(units, batch, ask, provider) or []:
+            kept = _accept(units, first, last, provider)
+            if kept:
+                remove.update(i for i in range(kept[0], kept[1] + 1) if units[i].text.strip())
+    spoken = [i for i, u in enumerate(units) if u.text.strip()]
+    pos = {i: k for k, i in enumerate(spoken)}
+    calls = 0
+    looked: Set[int] = set()
+    for anchor in _missed_anchors(units, remove):
+        if anchor in remove or anchor in looked or calls >= MAX_FOCUS_CALLS:
+            continue
+        k = pos[anchor]
+        window = spoken[max(0, k - FOCUS_RADIUS_UNITS) : k + FOCUS_RADIUS_UNITS + 1]
+        looked.update(window)
+        calls += 1
+        for first, last in _ask_blocks(units, window, ask, provider) or []:
+            kept = _accept(units, first, last, provider)
+            if kept and any(
+                kept[0] <= a <= kept[1] for a in _missed_anchors(units, remove) if a in window
+            ):
+                remove.update(i for i in range(kept[0], kept[1] + 1) if units[i].text.strip())
+    if calls:
+        logger.info("%s cleaning: second pass looked again at %d anchor(s)", provider, calls)
+    total = sum(len(u.text.split()) for u in units) or 1
+    share = sum(len(units[i].text.split()) for i in remove) / total
+    if share > MAX_EPISODE_SHARE:
+        logger.warning(
+            "%s cleaning: blocks cover %.0f%% of the episode -- not ad removal; nothing removed",
+            provider,
+            100 * share,
+        )
+        return units, set()
+    return units, remove
+
+
+def removed_char_ranges(units: Sequence[Unit], remove: Set[int]) -> List[Tuple[int, int]]:
+    """``[start, end)`` of each removed unit's text in the original string, in order."""
+    out: List[Tuple[int, int]] = []
+    pos = 0
+    for i, u in enumerate(units):
+        pos += len(u.sep)
+        if i in remove and u.text:
+            out.append((pos, pos + len(u.text)))
+        pos += len(u.text)
+    return out
+
+
+def clean_by_selection(
+    text: str,
+    ask: Callable[[str, str], Optional[str]],
+    *,
+    provider: str = "",
+) -> str:
+    """Clean ``text`` by asking the model, batch by batch, which blocks of sentences to DROP.
+
+    ``ask(system_prompt, user_prompt)`` is the provider's single call: it returns the model's raw
+    reply, or ``None`` when there is nothing usable (empty, guardrail, cut at the token cap). It
+    may raise for auth / rate-limit errors, as every provider call does. Everything else -- what
+    the model sees, how its answer is checked, what is removed -- is here, once, so every provider
+    cleans the same way.
+    """
