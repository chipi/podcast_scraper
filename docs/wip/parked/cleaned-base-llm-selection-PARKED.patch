+def _overlap_share(seg: Dict[str, Any], ranges: List[Tuple[int, int]]) -> float:
+    cs, ce = int(seg.get("char_start", 0)), int(seg.get("char_end", 0))
+    covered = sum(max(0, min(ce, hi) - max(cs, lo)) for lo, hi in ranges)
+    return covered / max(1, ce - cs)
+
+
+def _rebuild_without(
+    text: str, segments: List[Dict[str, Any]], cut: List[int]
+) -> Tuple[str, List[Dict[str, Any]]]:
+    """The base without the segments at indices ``cut``, offsets exact.
+
+    A diarized screenplay is RE-RENDERED from the survivors (every turn keeps its ``Name:``
+    marker); a plain transcript is cut by char range, survivors shifted left."""
+    cut_set = set(cut)
+    survivors = [s for i, s in enumerate(segments) if i not in cut_set]
+    rendered, _ = format_diarized_screenplay_with_offsets(segments)
+    if rendered == text:
+        return format_diarized_screenplay_with_offsets(survivors)
+    ranges = sorted((int(segments[i]["char_start"]), int(segments[i]["char_end"])) for i in cut_set)
+    out_segs: List[Dict[str, Any]] = []
+    for i, seg in enumerate(segments):
+        if i in cut_set:
