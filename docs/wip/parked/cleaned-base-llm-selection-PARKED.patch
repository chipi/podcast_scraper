+        ("Jon", "Download our games app at games.com slash play."),
+        ("Kevin", "Well, Casey, we've got a lot more technologies to get through."),
+        *[("Casey", _TALK)] * 10,
+    )
+    model = _BlockModel([("This episode is brought", "Well, Casey")])
