# Dev observability — point a terminal pipeline run at the homelab backends.
#
# The app emits 5 vendor-neutral signals but is a SILENT NO-OP unless these env vars
# are set (ADR-119). In prod, the VPS injects them + Alloy tails the pipeline containers.
# In dev there is no container, so a terminal run ships nothing until you source this.
#
# Setup:
#   cp .env.obs.dev.example .env.obs.dev     # then fill the real values (gitignored)
# Once the file exists, `config.py` AUTO-LOADS it on every dev run (skipped under pytest; the prod
# Docker image has no such file, so it no-ops there) — a bare `python -m podcast_scraper.cli ...`
# ships the five signals with no make target and no manual `source`. `override=False`, so an
# explicit shell env var still wins. (`set -a; source .env.obs.dev; set +a` also still works.)
#
# Backends live on the `homelab` host; reachable over Tailscale. Address them by the `homelab`
# name, never an IP (agentic-ai-homelab docs/recipes/observability-endpoints.md). Every value
# below is DEV-only: dev projects in GlitchTip and Langfuse, apart from prod's. Where each key
# lives on the mini: agentic-ai-homelab docs/recipes/agent-access.md §7 (GlitchTip), §8 (Langfuse).

# --- environment tag (dev vs prod) -------------------------------------------------
PODCAST_ENV=dev

# --- errors -> GlitchTip: the DEV projects (team `podcast`) --------------------------------
# GlitchTip's ingest port (:8090) answers on the mini's loopback only; from the tailnet use its node
# URL. UI: https://glitchtip.<tailnet>.ts.net. DSNs: the project's keys (agent-access.md §7).
PODCAST_SENTRY_DSN_PIPELINE=https://<podcast_pipeline_dev_public_key>@glitchtip.<tailnet>.ts.net/25
# The local api. Leave unset and it reports nothing (no built-in default since 2026-10-03).
PODCAST_SENTRY_DSN_API=https://<podcast_api_dev_public_key>@glitchtip.<tailnet>.ts.net/26

# --- LLM prompt/cost -> Langfuse ---------------------------------------------------
# The `podcast-dev` project (its key pair: agent-access.md §8). UI: https://langfuse.<tailnet>.ts.net
# Note: the pipeline's DGX calls reach Langfuse through the LiteLLM gateway's own callback
# (#2342), not through these keys; these cover the app's in-process spans.
LANGFUSE_HOST=http://homelab:4000
LANGFUSE_BASE_URL=http://homelab:4000
LANGFUSE_PUBLIC_KEY=<podcast-dev-langfuse-public-key>
LANGFUSE_SECRET_KEY=<podcast-dev-langfuse-secret-key>
# Langfuse's native environment field (dev/prod filter in the UI). SDK reads this var.
LANGFUSE_TRACING_ENVIRONMENT=dev

# --- traces -> VictoriaTraces (OTLP direct; in-app init, no launcher) ---------------
# One-time: pip install -e ".[otel]" && .venv/bin/opentelemetry-bootstrap -a install
# (installs the httpx/requests instrumentors so provider HTTP calls become spans). The app
# self-initialises OTLP tracing when these vars are set — a plain `python -m …cli` run traces.
OTEL_TRACES_EXPORTER=otlp
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://homelab:10428/insert/opentelemetry/v1/traces
OTEL_EXPORTER_OTLP_TRACES_PROTOCOL=http/protobuf
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
# OTEL_SERVICE_NAME is left unset: each process names itself (CLI -> podcast-pipeline, the
# server -> podcast-api), the same names prod uses. Serving the player? set player-api.
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev,service.namespace=podcast

# --- logs + metrics -> homelab, DIRECT PUSH from the app process (dev only; no daemon) ---
# The packaged Docker image leaves these UNSET -> in-app push is inert and Alloy ships them.
PODCAST_LOGS_PUSH_URL=http://homelab:9428/insert/jsonline
PODCAST_METRICS_PUSH_URL=http://homelab:8428/api/v1/import/prometheus
PODCAST_METRICS_ENABLED=1
# instance label = <worktree>-<port> by default so N worktrees/ports don't collide.
# PODCAST_OBS_PORT=8000
# PODCAST_OBS_INSTANCE=my-custom-instance

# --- Umami user-action analytics -> podcast_obs operator surface (ADR-126) -----------
# The control plane READS Umami to observe what users DID on the operator viewer / player
# (typed events, page/visitor totals, live users) via `podcast_obs analytics` and the Umami
# signals on `surface operator`. The website_id is PER-ENVIRONMENT (dev = the operator-dev
# site, prod = operator-prod) — the same shape as the player's build-time VITE_UMAMI_WEBSITE_ID.
# Reading needs admin auth: a token, OR a username+password pair we exchange via /api/auth/login.
# umami_url falls back to the VITE_UMAMI_SRC origin above if PODCAST_OBS_UMAMI_URL is unset.
# PODCAST_OBS_UMAMI_URL=http://homelab:3001
PODCAST_OBS_UMAMI_WEBSITE_ID=<operator-dev-website-uuid>
# PODCAST_OBS_UMAMI_TOKEN=<umami-api-token>
# PODCAST_OBS_UMAMI_USERNAME=<admin-user>
# PODCAST_OBS_UMAMI_PASSWORD=<admin-password>

# --- GlitchTip issue-link pivot -> podcast_obs (read API; OPTIONAL) ------------------
# Errors are ALWAYS visible token-free via VictoriaLogs (their text). This is only for PIVOTING
# into the GlitchTip UI — the issue page / permalink — which reads GlitchTip's issues API and so
# needs a read token + org/projects. Reuses the platform's existing SENTRY_AUTH_TOKEN (the GH
# secret); sentry_url derives from the PODCAST_SENTRY_DSN_* above. Token needs event:read /
# project:read scope on the GlitchTip integration (Release:Admin alone 401s the issues API).
# SENTRY_AUTH_TOKEN=<glitchtip-read-token>
# PODCAST_OBS_SENTRY_ORG=homelab
# PODCAST_OBS_SENTRY_PROJECTS=podcast-pipeline-dev,podcast-api-dev,player-dev
