// podcast_scraper-prod tailnet ACL.
//
// Applied to the live tailnet by Tailscale's GitOps ACL action
// (`.github/workflows/tailscale-acl.yml`): PR → test, merge to main → apply. This is the
// source of truth. It is NO LONGER managed by OpenTofu (ADR-128 — the tailscale_acl
// resource was removed from tofu state + config so an ACL edit no longer forces a
// full-estate apply).
//
// Owner: single operator. Add a collaborator by appending their tailnet
// identity to acls below and opening a PR. RFC-082 Decision 2 + Decisions-made #4.

{
  // Tag ownership. Only listed owners can apply these tags to devices.
  //   tag:prod         → the prod VPS (advertised by cloud-init's `tailscale up`)
  //   tag:dr-drill     → Hetzner DR drill VPS (workspace drill; RFC-082 #752)
  //   tag:gha-deployer → ephemeral GHA runner during deploy-prod.yml / drill-e2e
  //   tag:dgx-llm-host → operator DGX Spark (RFC-089); Ollama + embedding shim
  //   tag:homelab-host → homelab Mac mini; self-hosted observability (ADR-0005)
  //   tag:homelab-svc  → per-service Caddy tailnet nodes on the mini: each obs
  //                      service is its own node <name>.ts.net with its own
  //                      Tailscale cert (caddy-tailscale; agentic-ai-homelab
  //                      docs/wip/mac-mini-headless-server.md)
  //
  // tag:prod / tag:dr-drill are SELF-OWNED (list the tag as its own owner) so the
  // TS_INFRA_OAUTH client — which is bound to BOTH tags — can mint a per-server auth
  // key carrying just ONE of them. Tailscale lets an OAuth client mint a key with its
  // full tag set unconditionally, but a strict subset (one tag) only if the client's
  // tags include an owner of the requested tag; self-ownership provides that. Without
  // this, `tofu apply` fails minting tailscale_tailnet_key.prod ("requested tags
  // [tag:dr-drill] are invalid or not permitted", 400) — the OAuth-migration break of
  // 2026-08-03 vs the old Personal API token, which acted as autogroup:admin. Trade-off:
  // any tag:prod bearer (the prod VPS + the CI client) may now mint further tag:prod
  // keys; the cleaner split (dedicated tag:infra-minter owning both) is deferred.
  "tagOwners": {
    "tag:prod":         ["autogroup:admin", "tag:prod"],
    "tag:dr-drill":     ["autogroup:admin", "tag:dr-drill"],
    "tag:gha-deployer": ["autogroup:admin"],
    "tag:dgx-llm-host": ["autogroup:admin"],
    "tag:homelab-host": ["autogroup:admin"],
    "tag:homelab-svc":  ["autogroup:admin"]
  },

  // Implicit-deny for everything else; only listed traffic is permitted.
  "acls": [
    // Operator's own devices (laptop, phone, iPad — anyone with admin role)
    // reach the viewer + api over HTTPS, AND SSH for hands-on debugging
    // and the operator bootstrap flow (stage .env, restart unit).
    // Originally restricted SSH to tag:gha-deployer only, but that blocked
    // operator-side bootstrap (no way to stage host secrets); pragmatic to
    // grant SSH to admin too. Defence-in-depth still applies via SSH key auth.
    //
    // :8443 = orrery co-tenant tailnet publish (chipi/podcast_scraper#838,
    // chipi/orrery#260). orrery's web app at :8090 fronted via tailscale
    // serve on :8443, leaving :443 for podcast_scraper.
    // :4001 = the prod LiteLLM gateway admin UI (ADR-130 / #1357), published on
    // the box's tailnet IP by deploy-litellm.sh so admins reach it from a
    // laptop/phone; auth = the gateway master key. Never public (loopback + tailnet
    // only). Distinct from homelab's own :4001 gateway — different host.
    {
      "action": "accept",
      "src":    ["autogroup:admin"],
      "dst":    ["tag:prod:22,80,443,4001,8443"]
    },

    // Deploy workflow (ephemeral GHA runner under tag:gha-deployer) SSHes into
    // the VPS to run `docker compose pull && up`, then probes health over the
    // tailnet. :22 SSH · :443 the PODCAST api /api/health probe (deploy-prod.yml
    // #720 — tailscale-serve fronts the api on :443) · :8443 the orrery external
    // healthcheck. :443 was dropped when this grant was authored around the orrery
    // co-tenant (#838) — its absence hung deploy-prod.yml's post-deploy probe
    // (the api was healthy; the runner just couldn't reach :443).
    {
      "action": "accept",
      "src":    ["tag:gha-deployer"],
      "dst":    ["tag:prod:22,443,8443"]
    },

    // Delivery worker (#1412 / ADR-145): the homelab delivery worker polls the player-api
    // outbox (`/internal/outbox/*`, token-gated by INTERNAL_OUTBOX_TOKEN) published on the
    // prod VPS tailnet IP at :8099 by deploy-player.sh. Tailnet-only seam transport; the
    // token is the capability, the ACL scopes reachability to just the homelab host.
    //
    // :443 = the operator API (tailscale-serve fronts the api on :443, same listener the
    // admin grant above uses). The homelab drives corpus ingestion against /api/jobs on a
    // STANDING basis — feed batches are run from here over the coming months, not as a
    // one-off — so this is a durable grant. Auth remains the operator key
    // (X-Operator-Key); the ACL scopes reachability to just the homelab host, the same
    // capability-plus-network pattern as :8099 above.
    //
    // :4001 = the prod-local LiteLLM gateway admin API (ADR-130 / ADR-142). The homelab now
    // owns ingestion, so it also needs to read the spend the ingestion incurs — per-episode
    // cost, budget headroom against the podcast-prod key's $25 cap, and whether routing is
    // landing on the prod gateway rather than leaking to homelab (the ADR-142 regression).
    // Without this the box driving the pipeline is blind to what the pipeline costs, and cost
    // review needs an admin device every time. Auth is the gateway master key; the ACL scopes
    // reachability to the homelab host only. The HTTP surfaces here are read-only in
    // practice — analysis, not config changes. NOTE the :22 grant below is NOT read-only;
    // see its own note for why it was added and what would let it be removed again.
    //
    // :22 = operator SSH from the homelab box. Added 2026-08-18 after operator SSH to prod
    // stopped working and was misdiagnosed twice (first as an sshd/firewall fault, then as a
    // fail2ban ban — disproved because the ban would have expired and the failure did not).
    // The actual cause: the mini is a TAGGED node (tag:homelab-host), and a tagged device has
    // no user owner, so the `autogroup:admin -> tag:prod:22,80,443,4001,8443` rule above never
    // matched it. It kept exactly the ports granted here — 443 and 4001 answered while 22 and
    // 80 timed out — which is the signature of an ACL scope miss, not a host problem.
    //
    // This GRANTS access the mini never had; it does not restore something lost. An earlier
    // draft of this note claimed the Caddy-era tagging had revoked prod SSH — wrong, and worth
    // recording so the next reader does not inherit it. The mini has carried tag:homelab-host
    // since 2026-07-22 (83369885), and its tag:prod grants (fd337a17 :443, cc813f0d :4001,
    // both 2026-08-12) never included :22. Tailscale SSH does not cover it either — the ssh
    // block's only dst has ever been tag:dgx-llm-host. Operator recollection of "SSH to prod
    // from the mini" was almost certainly the :443 HTTPS API granted the day before the first
    // prod corpus load, or a session from the untagged admin laptop (the Hetzner key is named
    // operator-laptop, and no id_ed25519 exists on the mini).
    //
    // This DOES widen a server tag to interactive SSH, which cuts against the Level-3 trim
    // (#1665/#1670) that removed closed raw ports. Accepted deliberately: the operator shell
    // lives on this box, and the corpus-repair runbook's read-only steps (integrity check,
    // preprocessing audit, work-list) have no other execution path — reprocess-prod.yml is the
    // only workflow that runs corpus tooling on the box, and it is the expensive WRITE step.
    // Revisit once those steps have their own read-only workflow: the durable fix is that the
    // baselines stop needing a human shell at all, at which point this grant can go back out.
    {
      "action": "accept",
      "src":    ["tag:homelab-host"],
      "dst":    ["tag:prod:22,443,4001,8099"]
    },

    // DR drill VPS — operator + GHA reach SSH and viewer/api over HTTPS.
    // MagicDNS https://<host>.<tailnet>/ requires `tailscale serve` on the
    // node (cloud-init wires ExecStartPost on podcast-scraper.service); ACL
    // alone is not enough if serve was never started.
    {
      "action": "accept",
      "src":    ["autogroup:admin"],
      "dst":    ["tag:dr-drill:22,80,443"]
    },
    {
      "action": "accept",
      "src":    ["tag:gha-deployer"],
      "dst":    ["tag:dr-drill:22,80,443"]
    },

    // RFC-089 / ADR-096 / #814 / #926 / #953:
    //   :11434 = DGX Ollama (LLM stages).
    //   :8000  = faster-whisper-server / speaches (transcription stage; #814).
    //   :8001  = pyannote diarization service (#926; #943 adds /metrics).
    //   :8002  = openai-whisper service (first-party Whisper code; #953).
    //            Runs alongside speaches:8000 until #952 picks the winner.
    //   :8003  = vLLM autoresearch slot (ADR-147: naming/summary/GI/KG/grounding
    //            + the in-pipeline value gate; the fully-airgapped DGX profiles).
    //   :8004  = MOSS transcribe-diarize (ASR coverage failover; #1273 / ADR-123).
    // #943 observability sidecars:
    //   :8080  = cAdvisor (per-container resource use).
    //   :9100  = node-exporter (host CPU/mem/disk/net).
    //   :9400  = DCGM exporter (per-GPU util/mem/temp/power).
    // Cloud fallback is enforced in profile config, not the ACL.
    {
      "action": "accept",
      "src":    ["autogroup:admin", "tag:gha-deployer"],
      "dst":    ["tag:dgx-llm-host:11434", "tag:dgx-llm-host:8000", "tag:dgx-llm-host:8001", "tag:dgx-llm-host:8002", "tag:dgx-llm-host:8003", "tag:dgx-llm-host:8004", "tag:dgx-llm-host:8080", "tag:dgx-llm-host:9100", "tag:dgx-llm-host:9400"]
    },
    {
      "action": "accept",
      "src":    ["tag:dr-drill"],
      "dst":    ["tag:dgx-llm-host:11434", "tag:dgx-llm-host:8000", "tag:dgx-llm-host:8001", "tag:dgx-llm-host:8002"]
    },
    {
      "action": "accept",
      "src":    ["tag:prod"],
      "dst":    ["tag:dgx-llm-host:11434", "tag:dgx-llm-host:8000", "tag:dgx-llm-host:8001", "tag:dgx-llm-host:8002", "tag:dgx-llm-host:8003", "tag:dgx-llm-host:8004", "tag:dgx-llm-host:8080", "tag:dgx-llm-host:9100", "tag:dgx-llm-host:9400"]
    },
    {
      // homelab Mac mini (tag:homelab-host) scrapes DGX telemetry over the TAILNET
      // (infra/dgx-scrape) — GPU (dcgm :9400), containers (cadvisor :8080), app
      // /metrics (moss :8004, pyannote :8001), and TCP health of the inference
      // services (:11434/:8000/:8002/:8003/:8004). Replaces the fragile LAN path
      // (192.168.1.111 changed when the DGX dropped off the home LAN).
      //
      // :8003 (vLLM autoresearch) added 2026-09-03. It was missing, and the mini RUNS THE
      // PIPELINE — it is not only a scraper. The effect was a silent partial outage that looked
      // like a healthy run: ASR (:8000) and diarization (:8001) were granted and worked, while
      // every LLM stage — KG extraction, GI, summarization — had its packets DROPPED (timeout,
      // not refusal, which is why nothing logged a connection error). The pipeline then fell back
      // to substituting summary bullets as KG topics and shipped episodes with zero insights,
      // recording ``kg_failures=0`` throughout.
      //
      // This is the same shape as the :22 SSH brick documented in the rule immediately below —
      // a missing port grant on a rule whose comment describes a narrower purpose than the node's
      // actual use. Both times the symptom was "some ports work, one times out".
      "action": "accept",
      "src":    ["tag:homelab-host"],
      "dst":    ["tag:dgx-llm-host:11434", "tag:dgx-llm-host:8000", "tag:dgx-llm-host:8001", "tag:dgx-llm-host:8002", "tag:dgx-llm-host:8003", "tag:dgx-llm-host:8004", "tag:dgx-llm-host:8080", "tag:dgx-llm-host:9100", "tag:dgx-llm-host:9400"]
    },
    {
      // Operator (laptop/phone via autogroup:admin) + homelab mini reach the DGX
      // over SSH (:22). Tailscale SSH needs BOTH halves: the `ssh` block governs
      // auth + user-mapping, and THIS grant is the packet-filter half. RunSSH +
      // the ssh-rule alone still get dropped without a :22 grant — that missing
      // grant was the SSH brick (2026-07; every device timed out on :22 while
      // :9400 etc. worked, because only those ports were granted).
      "action": "accept",
      "src":    ["autogroup:admin", "tag:homelab-host"],
      "dst":    ["tag:dgx-llm-host:22"]
    },

    // homelab Mac mini (tag:homelab-host) — self-hosted observability stack
    // (ADR-0005). Operator reaches the dashboards + SSH; DGX + prod push
    // telemetry to it. These grants were previously hand-added in the admin
    // console and got wiped by a `tofu apply` (they lived nowhere in-repo);
    // pinned here so they survive future applies.
    //   :3000 Grafana  :4000 Langfuse  :8888 homelab start page (basic-auth, tailnet-only)
    //   :8428 VictoriaMetrics  :9428 VictoriaLogs  :10428 VictoriaTraces
    //   :4001 LiteLLM gateway API (the homelab's LLM proxy — fleets today, any
    //         project/box tomorrow; auth = per-consumer virtual keys w/ budgets)
    //   Level-3 trim (#1665): GlitchTip (:8090) + Umami (:3001) are now CLOSED on the mini
    //   (loopback-only, refused from the tailnet) — reached via their per-service
    //   caddy-tailscale TLS nodes (glitchtip./umami.<TAILNET>:443, tag:homelab-svc grant
    //   below). The dedicated `tailscale serve` TLS ports (:8443 Langfuse, :8444 Umami,
    //   :8445 GlitchTip, :10000 LiteLLM admin UI) are removed — serve is empty. The
    //   temporary Caddy reverse-proxy migration port (:9443) is removed — migration done.
    {
      "action": "accept",
      "src":    ["autogroup:admin"],
      "dst":    ["tag:homelab-host:22,443,3000,4000,4001,8428,8888,9428,10428"]
    },
    // Per-service Caddy tailnet nodes (tag:homelab-svc): each obs service is its own
    // node <name>.tail6d0ed4.ts.net serving its own Tailscale cert (caddy-tailscale).
    // Admin devices reach them over HTTPS (dashboards). tag:dgx-llm-host pushes
    // telemetry over TLS to vm./vlogs. — the durable successor to plaintext pushes at
    // tag:homelab-host:8428/9428. (The grant also gives DGX netmap visibility, so
    // MagicDNS resolves the node names.) Durable successor to the port/path serve
    // grants on tag:homelab-host above — those get trimmed once every service has
    // moved to its own node. (agentic-ai-homelab docs/wip/mac-mini-headless-server.md)
    {
      "action": "accept",
      "src":    ["autogroup:admin", "tag:dgx-llm-host", "tag:prod"],
      "dst":    ["tag:homelab-svc:443"]
    },
    {
      // prod (the box) reaches homelab RAW only for the paths with no TLS node yet
      // (verified live on the prod box, Level-3 close-out #1665):
      //   :4000  Langfuse       — LiteLLM callbacks (LANGFUSE_HOST=http://homelab:4000)
      //   :4001  LiteLLM gateway — homelab LLM proxy (per-key budgets gate spend, not the net)
      //   :8428  VictoriaMetrics — litellm-spend-push imports spend metrics (raw, not via Alloy)
      //   :10428 VictoriaTraces  — api OTLP traces (OTEL_EXPORTER_OTLP_TRACES_ENDPOINT, no TLS node)
      // DROPPED at Level-3 close-out: Umami :3001 + GlitchTip :8090 (homelab closed them —
      // loopback-only; prod now ingests via the umami./glitchtip. TLS nodes on :443), and
      // :9428 VictoriaLogs (the Alloy log push moved to the vlogs. TLS node). NB: :8428 and
      // :10428 are KEPT — spend-push + OTLP traces bypass Alloy and are still raw.
      "action": "accept",
      "src":    ["tag:dgx-llm-host", "tag:prod"],
      "dst":    ["tag:homelab-host:4000,4001,8428,10428"]
    },
    {
      // gha-deployer (ephemeral GHA runner) pushes Tier-1 CI/ops events —
      // deploy / backup / drill / drift — to homelab VictoriaLogs :9428 over the
      // tailnet (ADR-119; scripts/ops/emit_ops_event.sh). Write-only ingest, :9428
      // only, so runner-side events land next to app telemetry on one Grafana pane.
      "action": "accept",
      "src":    ["tag:gha-deployer"],
      "dst":    ["tag:homelab-host:9428"]
    },

    // Operator's own devices reach EACH OTHER over the tailnet (phone ↔ laptop ↔
    // mac mini) for hands-on work — SSH, file share, screen share. `autogroup:self`
    // scopes the destination to devices owned by the SAME user as the source, so on
    // this single-operator tailnet it is exactly "my devices talk to my devices" and
    // exposes nothing cross-user. Without it, UNTAGGED personal devices (a laptop/phone,
    // which are not tag:* hosts) had zero incoming grant, so e.g. phone→MBP:22 timed out
    // — the packet filter dropped it before sshd. Tagged hosts (prod/dgx/homelab) are
    // unaffected; this only adds owner-device-to-owner-device reachability.
    {
      "action": "accept",
      "src":    ["autogroup:member"],
      "dst":    ["autogroup:self:*"]
    }

    // (Future, for #714 + #723) Home Assistant subscribes to /api/jobs.
    // Uncomment and add HA's tailnet identity once that integration lands.
    // ,
    // {
    //   "action": "accept",
    //   "src":    ["user:homeassistant@example.com"],
    //   "dst":    ["tag:prod:443"]
    // }
  ],

  // No auto-approvers — manual approval for any new tagged device, slowing
  // down the bad-key compromise path.
  "autoApprovers": {
    "routes":   {},
    "exitNode": []
  },

  // Tailscale SSH — narrowly enabled for the DGX host only (RFC-089 / #897
  // post-merge). Operator (autogroup:admin) reaches dgx-llm-host as either
  // operator (the actual login user) or root (emergencies). Tailnet
  // identity authenticates; no SSH keys to manage on the operator side.
  //
  // Prod / drill VPSes intentionally NOT covered — they keep classic key-
  // based SSH so prod's auth model is identical between operator and CI
  // (deploy-prod.yml uses an SSH key in GHA). Don't widen this block to
  // tag:prod / tag:dr-drill without revisiting that design.
  "ssh": [
    {
      "action": "accept",
      "src":    ["autogroup:admin", "tag:homelab-host"],
      "dst":    ["tag:dgx-llm-host"],
      // markodragoljevic: the operator's ACTUAL login account on the DGX. The list above is
      // role accounts only, so `ssh dgx-llm-1` as the operator was refused by Tailscale SSH
      // ("tailnet policy does not permit you to SSH as user") before the key was ever
      // considered — the agent hit this on 2026-08-30 trying to run gpu-mode-swap.sh.
      // Named explicitly rather than autogroup:nonroot: same access, but the policy says who.
      "users":  ["operator", "ops", "root", "markodragoljevic"]
    }
  ]
}
