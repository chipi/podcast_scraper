// podcast.alloy — the OPERATOR podcast stack's log rules for the shared node Alloy
// (ADR-121). Dropped into /opt/vps-observability/config.d/podcast.alloy on the operator
// deploy and hot-reloaded (`docker kill -s HUP alloy`). Mirrors orrery.alloy / player.alloy.
//
// WHY: base.alloy defines only the SHARED components (discovery.docker "app",
// loki.write "logs_sink") + host journal/caddy sources — it does NOT collect per-container
// docker logs. Each app contributes its own scoped loki.source.docker via a drop-in. The
// operator stack (compose-api-1 + compose-viewer-1) never had one, so its container logs
// were absent from VictoriaLogs and the "Podcast Operator" Grafana board's app-event
// panels (querying app=podcast) were empty. This drop-in fixes that.
//
// References shared components in base.alloy:
//   - discovery.docker "app"   — the Docker-socket container discovery
//   - loki.write "logs_sink"   — the VictoriaLogs sink
// Do NOT touch base.alloy or the orrery/player sources.

// ---------- Operator podcast stack containers (compose project `compose`) ----------
// Keep the operator api + viewer AND the ephemeral pipeline-llm job container. surface=api|web
// mirrors the orrery/player split; surface=pipeline is the docker-mode pipeline run spawned by the
// api (`docker compose run pipeline-llm`), named ``compose-pipeline-llm-run-<id>`` — without this it
// was never discovered, so {app="podcast",surface="pipeline"} was empty in VictoriaLogs (P2.7).
//
// ALSO keep the NAMED ad-hoc pipeline containers: reprocess-prod.yml and sweep-prod-audio.yml pass
// ``run --rm --name podcast-(reprocess|sweep)-<run-id>`` (so a box-side watchdog can kill by name,
// #1807/41b52760). That `--name` moved them OUT of the ``compose-pipeline-llm*`` pattern, so repairs
// and sweeps were INVISIBLE in VictoriaLogs — the box was the only place their logs existed. They
// run the same pipeline image, so they also get surface=pipeline. (2026-08-22.)
discovery.relabel "podcast" {
	targets = discovery.docker.app.targets

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(compose-api-1|compose-viewer-1|compose-pipeline-llm[-_].*|podcast-(reprocess|sweep)[-_].*)"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/compose-api-1"
		target_label  = "surface"
		replacement   = "api"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/compose-viewer-1"
		target_label  = "surface"
		replacement   = "web"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(compose-pipeline-llm[-_]|podcast-(reprocess|sweep)[-_]).*"
		target_label  = "surface"
		replacement   = "pipeline"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		target_label  = "container"
		regex         = "/(.*)"
		replacement   = "$1"
	}
}

loki.source.docker "podcast" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.podcast.output
	forward_to = [loki.process.podcast_denoise.receiver]
	labels     = {app = "podcast"}
}

// The PUBLIC operator stack (compose/docker-compose.operator-public.yml, operator.closelistening.app):
// a separate composition whose containers are operator-api-1 / operator-viewer-1, so the keep-filter
// above never matched them and the internet-facing operator shipped no logs at all (found
// 2026-10-14: 0 lines in 7 days). Its own source, NOT a wider regex above: adding targets to the
// "podcast" source would change its read positions and re-read every log it tails. app=operator +
// surface=public-api|public-web gives service=operator-public-api, the OTel service.name.
discovery.relabel "operator_public" {
	targets = discovery.docker.app.targets

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(operator-api-1|operator-viewer-1)"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/operator-api-1"
		target_label  = "surface"
		replacement   = "public-api"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/operator-viewer-1"
		target_label  = "surface"
		replacement   = "public-web"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		target_label  = "container"
		regex         = "/(.*)"
		replacement   = "$1"
	}
}

loki.source.docker "operator_public" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.operator_public.output
	forward_to = [loki.process.podcast_denoise.receiver]
	labels     = {app = "operator"}
}

// Drop the uvicorn access-log NOISE for successful health/metrics polls (probes +
// Prometheus scrapes hit these every few seconds). Matches only 2xx (`" 2`), so a FAILING
// health check (4xx/5xx) is still kept as a signal.
loki.process "podcast_denoise" {
	forward_to = [loki.relabel.naming.receiver]

	stage.drop {
		expression          = "\"(GET|HEAD) /(api/(app/)?)?(health|metrics) HTTP/1[^\"]*\" 2"
		drop_counter_reason = "healthcheck_noise"
	}

	// homelab log standard (agentic-ai-homelab/infra/observability/LOG-STANDARD.md):
	// extract the 32-hex trace id (trace_id=<id>, "trace_id":"<id>", trace=<id>, traceparent,
	// sentry-trace — every shape the apps write; same pattern as Grafana's derived field) into
	// structured_metadata (a queryable field, NOT a high-cardinality stream label).
	// Inlined here (rather than referencing base's homelab_std) so this drop-in
	// deploys independently of a base.alloy rollout.
	stage.regex {
		expression = "(?:trace_id[=\":\\s]+|trace=|00-|sentry-trace[=\":\\s]+)(?P<trace_id>[a-f0-9]{32})"
	}

	// Pipeline correlation (P2). Every pipeline log line carries the run bracket
	// `[run=<run_id> trace=<trace_id>]` (orchestration.py:2530 formatter); reprocess / enrich /
	// sweep runs all stamp it. Extract run_id so VictoriaLogs is filterable by run — the thing
	// you pivot on when a specific reprocess misbehaves. `run-[^\]\s]+` matches only a real run
	// id (run-<ts>Z), so a line with `run=-` (no run) captures nothing and defaults "".
	stage.regex {
		expression = "\\[run=(?P<run_id>run-[^\\]\\s]+)"
	}

	// Episode id WHEN PRESENT: only some lines carry `episode_id=<id>` (e.g. jsonl_emitter
	// episode_finished / metrics-missing), so this is best-effort — the regex captures nothing
	// on lines without it and the field defaults "". Not in the run bracket, hence a 2nd stage.
	stage.regex {
		expression = "episode_id=(?P<episode_id>[^\\s)\\]]+)"
	}

	stage.structured_metadata {
		values = {trace_id = "", run_id = "", episode_id = ""}
	}

	// Events emitted to stdout (emit_event, sink="log") arrive behind the app's text log prefix
	// (`<time> INFO <logger> [run=…]: {"ts": …, "event_type": …}`), so VictoriaLogs could not
	// unpack them: on prod, event_type:llm_cost matched nothing while the lines were there
	// (2026-10-14), and the LLM cost panels stayed empty. Ship the event's JSON object alone —
	// VictoriaLogs unpacks a line that is one JSON object into fields, as it does the app event
	// files (base.alloy). Last, so the stages above still read the full line; a line that is
	// already bare JSON (the api's) is captured whole and passes unchanged.
	stage.match {
		selector = "{app=\"podcast\"} |= \"\\\"event_type\\\": \""

		stage.regex {
			expression = "(?P<event_json>\\{\"ts\": \".*\\})\\s*$"
		}

		stage.output {
			source = "event_json"
		}
	}
}
