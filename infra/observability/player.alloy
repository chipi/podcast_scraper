// player.alloy — Consumer player's log rules for the shared node Alloy (ADR-121).
// Dropped into the box's /opt/vps-observability/config.d/player.alloy on the player
// deploy and hot-reloaded (`docker kill -s HUP alloy`). Mirrors orrery.alloy — one
// node Alloy per box, each app contributes its own label rules as a drop-in.
//
// References shared components defined in base.alloy:
//   - discovery.docker "app"   — the Docker-socket container discovery
//   - loki.write "logs_sink"   — the VictoriaLogs sink (sets instance/cluster;
//                                app + per-stream labels are set HERE)
// Do NOT touch base.alloy or the podcast/orrery sources.

// ---------- Player stack containers (compose project `player`) ----------
// Keep ONLY player-api-* (the app-only backend) + player-learning-app-* (the PWA
// nginx). surface=api|app mirrors the podcast/orrery split. A precise keep-filter
// (not a broad glob) is what stops the cross-app mislabel the old orrery agent hit.
discovery.relabel "player" {
	targets = discovery.docker.app.targets

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/(player-api-.*|player-learning-app-.*|player-digest-scheduler-.*)"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/player-api-.*"
		target_label  = "surface"
		replacement   = "api"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/player-learning-app-.*"
		target_label  = "surface"
		replacement   = "app"
	}

	// The digest scheduler sidecar (#1412): ship its per-cycle `tick`/`cycle error` lines so the
	// homelab dead-man can alert if it stops (network:none → logs are its only liveness signal out).
	rule {
		source_labels = ["__meta_docker_container_name"]
		regex         = "/player-digest-scheduler-.*"
		target_label  = "surface"
		replacement   = "scheduler"
	}

	rule {
		source_labels = ["__meta_docker_container_name"]
		target_label  = "container"
		regex         = "/(.*)"
		replacement   = "$1"
	}
}

loki.source.docker "player" {
	host       = "unix:///var/run/docker.sock"
	targets    = discovery.relabel.player.output
	forward_to = [loki.process.player_denoise.receiver]
	labels     = {app = "player"}
}

// Drop the uvicorn access-log NOISE for successful health/metrics polls — probes +
// Prometheus scrapes hit these every few seconds and drown real requests in VictoriaLogs.
// Matches only 2xx (`" 2`), so a FAILING health check (4xx/5xx) is still kept as a signal.
loki.process "player_denoise" {
	forward_to = [loki.write.logs_sink.receiver]

	stage.drop {
		expression          = "\"(GET|HEAD) /(api/(app/)?)?(health|metrics) HTTP/1[^\"]*\" 2"
		drop_counter_reason = "healthcheck_noise"
	}

	// homelab log standard (agentic-ai-homelab/infra/observability/LOG-STANDARD.md):
	// extract the 32-hex trace id from a traceparent/sentry-trace pattern into
	// structured_metadata (a queryable field, NOT a high-cardinality stream label).
	// Inlined here (rather than referencing base's homelab_std) so this drop-in
	// deploys independently of a base.alloy rollout.
	stage.regex {
		expression = "(?:00-)?(?P<trace_id>[a-f0-9]{32})-[a-f0-9]{16}"
	}
	stage.structured_metadata {
		values = {trace_id = ""}
	}
}
