# Player Umami analytics vhost — TRACKING-ONLY (ADR-114). Deploy (deploy-player.sh) seds
# the real player domain in and drops this into /etc/caddy/sites/player-analytics.caddy,
# then restarts caddy. Mirrors analytics.caddy (orrery) — same homelab Umami, a separate
# Umami WEBSITE for the player.
#
# WHY: the player loads Umami's tracking script + POSTs events from the end user's browser,
# which can only reach public endpoints — never the tailnet-only Umami on homelab:3001.
# This vhost fronts ONLY the tracking surface through the shared public edge (behind
# Cloudflare + origin-lock); the Umami DASHBOARD/login/API stays tailnet-only (operator
# reaches it over the tailnet at homelab:3001).
#
# PUBLIC SURFACE (Umami v2):
#   GET  /script.js  — the tracking script the browser loads
#   POST /api/send   — the event-collect endpoint the script POSTs to (+ CORS preflight)
# Everything else (/, /login, the rest of /api, admin) → 404, not proxied.
#
# UPSTREAM (Level 3 #1665): Umami runs on **homelab**, now reached over the tailnet via its
# per-service caddy-tailscale TLS node (umami.<TAILNET>, real cert) instead of the raw
# homelab:3001 port. __TAILNET__ is sed'd to the tailnet suffix by deploy-config.yml (never
# hardcoded here — deny-list gate). Requires the prod→tag:homelab-svc:443 ACL grant (#1665, merged).
#
# Rollback: revert this file to `reverse_proxy homelab:3001` + `sudo systemctl restart caddy`
# (the raw :3001 stays open until the Level 3 cleanup, so revert is lossless).
analytics.player.example.com {
	import hardened
	# Per-site ACME email — info@<player domain> (the deploy seds player.example.com).
	tls info@player.example.com

	# Tracking-only surface — the script + the collect endpoint (any method, so the CORS
	# OPTIONS preflight to /api/send is proxied and Umami answers it). Both slash forms of the
	# collect path are matched so a client variant POSTing /api/send/ is not 404'd.
	@track path /script.js /api/send /api/send/
	handle @track {
		# The node matches STRICTLY on Host and silently drops a foreign Host (empty 200 →
		# events lost), so header_up Host to the node name is REQUIRED.
		reverse_proxy https://umami.__TAILNET__ {
			header_up Host umami.__TAILNET__
		}
	}

	# Dashboard / login / rest of the API — NOT public. Refuse without revealing Umami.
	handle {
		respond "Not Found" 404
	}
}
