# operator.closelistening.app — CLOSED. The operator surface is tailnet-only.
#
# Operator decision 2026-10-05: "The operator service is not going to get public anytime soon, so
# let's make sure it's accessible over tailscale only. And when I get to place that it should go
# beyond, we'll retain the security." Operator work happens on the CONTROL plane's viewer over
# MagicDNS (https://<prod tailnet host>/), which was always tailnet-only and is where the feed
# list and the operator overrides (#2283) are written.
#
# So this vhost proxies NOTHING to the app: every path, with or without the old /preview
# basic-auth or cl_op_preview cookie, gets the coming-soon page. The operator-public compose
# (RFC-108) still runs on loopback 127.0.0.1:8093, unreachable from outside the box. Re-opening
# it is a deliberate decision that must re-review its security (admin routes, sign-in, CSRF) —
# git history holds the gated version this replaced.
#
# Kept as a site (not removed) so the domain keeps a valid cert and a calm page instead of an
# edge error, and so the deploy's public probe (200 at /) still checks DNS + Cloudflare + TLS.

operator.closelistening.app {
	import hardened
	# Per-site ACME email (same domain family; LE cert under info@closelistening.app).
	tls info@closelistening.app

	# Everyone -> coming soon (no-store so it is never cached as the answer for a later reopen).
	handle {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "no-store"
		respond <<HTML
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Close Listening</title>
  <style>
    :root { color-scheme: dark; }
    html,body { height:100%; margin:0; }
    body { display:grid; place-items:center; min-height:100vh;
      font: 400 17px/1.6 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
      background: radial-gradient(1200px 600px at 50% -10%, #1a2233, #0b0e14 60%); color:#e7ecf3; }
    .wrap { text-align:center; padding:2rem; max-width:34rem; }
    .mark { letter-spacing:.14em; font-size:.8rem; text-transform:uppercase; color:#8aa0bd; }
    h1 { font-size:clamp(2rem,6vw,3.2rem); margin:.4rem 0 .6rem; font-weight:600; }
    p { color:#aab6c7; margin:0 auto; max-width:26rem; }
    .soon { display:inline-block; margin-top:1.6rem; padding:.5rem 1rem; border:1px solid #2b3a52;
      border-radius:999px; font-size:.85rem; color:#9fb2cc; }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="mark">Close Listening</div>
    <h1>Something worth hearing.</h1>
    <p>A calmer way to listen to podcasts — with the good parts surfaced. We're putting on the finishing touches.</p>
    <div class="soon">Coming soon</div>
  </div>
</body>
</html>
HTML 200
	}
}
