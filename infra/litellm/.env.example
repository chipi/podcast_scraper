# LiteLLM prod-gateway secrets (#1357, ADR-142). On prod these are delivered by the
# sops flow (infra/secrets/), NOT hand-copied — this file documents the slots. NEVER
# commit a real .env (repo rule; infra/litellm/.gitignore excludes it).

# postgres (compose-internal + loopback :5433 for the spend pusher)
LITELLM_PG_PASSWORD=<generate: openssl rand -hex 24>

# admin master key — mint per-consumer virtual keys with it; consumers NEVER get it
LITELLM_MASTER_KEY=sk-<generate: openssl rand -hex 24>

# provider routes — the VPS gateway gets its OWN upstream OpenRouter key so provider-side
# billing separates prod from homelab/lab spend (per-vertical key initiative, #1357 §2).
OPENROUTER_API_KEY=<the prod OpenRouter key>
# future direct providers (uncomment + add the alias route in config.yaml):
# DEEPSEEK_API_KEY=
# GEMINI_API_KEY=

# --- telemetry callbacks → homelab over the tailnet -------------------------------
# CRITICAL PROD DIFFERENCE vs homelab: Langfuse/GlitchTip are REMOTE here. Use the
# `homelab` name (NOT host.docker.internal — that's the prod host, which runs neither).
# deploy-litellm.sh pins homelab's tailnet IP into extra_hosts so the container resolves it.

# Langfuse — own project for the VPS gateway (keep separate from homelab's `litellm-gateway`)
LANGFUSE_HOST=http://homelab:4000
LANGFUSE_PUBLIC_KEY=<from the `litellm-vps` Langfuse project>
LANGFUSE_SECRET_KEY=<from the `litellm-vps` Langfuse project>

# GlitchTip (sentry-compatible) errors for the gateway itself — own project
SENTRY_DSN=<from the litellm-vps GlitchTip project @ homelab:8090>

# Written FRESH by deploy-litellm.sh each deploy (homelab tailnet IP for extra_hosts).
# Leave blank here; do not hand-edit.
HOMELAB_TAILNET_IP=
