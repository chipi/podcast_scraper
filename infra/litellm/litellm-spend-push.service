[Unit]
# Push the prod LiteLLM gateway's per-key spend to homelab VictoriaMetrics (#1357, ADR-142).
# Oneshot fired by litellm-spend-push.timer; reads the gateway Postgres via docker exec.
Description=Push LiteLLM per-key spend to homelab VictoriaMetrics
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Runs from the repo checkout (installed there by cloud-init, like the container-metrics
# collector). Needs docker group (docker exec) + tailnet reachability to homelab:8428.
ExecStart=/srv/podcast-scraper/infra/litellm/spend-to-vm.sh
# Environment=VM_URL=http://homelab:8428/api/v1/import/prometheus
