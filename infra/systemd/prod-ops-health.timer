[Unit]
Description=Daily prod ops health check at 06:00 UTC (after the 00:00 UTC nightly)

[Timer]
OnCalendar=*-*-* 06:00:00 UTC
# A box that was down at 06:00 runs the check when it comes back, so the homelab's 27 h
# stale rule only fires when the scheduler itself is broken.
Persistent=true

[Install]
WantedBy=timers.target
