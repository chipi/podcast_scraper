[Unit]
# Daily between-deploys prod health check (#1876, scheduled on the box by #1877).
# Started by prod-ops-health.timer; run by hand with `sudo systemctl start prod-ops-health`.
Description=Prod ops health check (pushes prod_ops_health_* to the homelab VictoriaMetrics)
After=docker.service network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/srv/podcast-scraper
ExecStart=/srv/podcast-scraper/scripts/ops/prod_ops_health_scheduled.sh
TimeoutStartSec=10min
