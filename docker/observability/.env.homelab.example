# Homelab podcast-obs deploy — read tokens/creds. Copy to .env.homelab (gitignored) and fill.
#   docker compose -f docker-compose.homelab.yml --env-file .env.homelab up -d
#
# Everything here is OPTIONAL: with none of it set, the control plane still serves logs / metrics /
# traces / cost / pipeline_stage token-free (tailnet is the auth for the Victoria backends). The
# tokens only unlock the extra pivots (GlitchTip issue links, Langfuse LLM traces, Umami usage).

# Pin a reproducible image instead of :latest (recommended for prod):
# OBS_IMAGE=ghcr.io/chipi/podcast-obs:sha-<git-sha>

# --- backends: override only if your homelab addresses differ from the tailnet-IP defaults --------
# PODCAST_LOGS_PUSH_URL=http://100.87.33.61:9428/insert/jsonline
# PODCAST_METRICS_PUSH_URL=http://100.87.33.61:8428/api/v1/import/prometheus
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://100.87.33.61:10428/insert/opentelemetry/v1/traces
# PODCAST_OBS_API_BASE=http://prod-podcast:8080

# --- Langfuse (LLM traces) ------------------------------------------------------------------------
# LANGFUSE_HOST=http://100.87.33.61:4000
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...

# --- GlitchTip issue-link pivot (read API) — needs event:read/project:read scope ------------------
# PODCAST_SENTRY_DSN_PIPELINE=http://<key>@100.87.33.61:8090/1
# SENTRY_AUTH_TOKEN=<glitchtip-read-token>
# PODCAST_OBS_SENTRY_ORG=homelab
# PODCAST_OBS_SENTRY_PROJECTS=podcast,player

# --- Umami user-action analytics (operator surface) — per-env website id --------------------------
# PODCAST_OBS_UMAMI_URL=http://100.87.33.61:3001
# PODCAST_OBS_UMAMI_WEBSITE_ID=<operator-prod-website-uuid>
# PODCAST_OBS_UMAMI_TOKEN=<umami-api-token>
