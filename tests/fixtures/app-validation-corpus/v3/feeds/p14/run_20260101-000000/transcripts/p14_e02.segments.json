"sent_id": "t0001.s01"
},
{
"start": 11.82,
"end": 13.44,
"speaker_label": "Inês Carvalho",
"text": "Glad to be back.",
"char_start": 233,
"char_end": 249,
"unit_id": "t0001.u01",
"sent_id": "t0001.s02"
},
{
"start": 13.44,
"end": 16.14,
