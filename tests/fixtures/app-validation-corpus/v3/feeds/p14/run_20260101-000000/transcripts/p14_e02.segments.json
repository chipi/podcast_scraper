"char_end": 232,
"unit_id": "t0001.u01",
"sent_id": "t0001.s01"
},
{
"start": 15.867,
"end": 17.798,
"speaker_label": "Inês Carvalho",
"text": "Glad to be back.",
"char_start": 233,
"char_end": 249,
"unit_id": "t0001.u01",
"sent_id": "t0001.s02"
},
{
"start": 17.798,
"end": 21.12,
