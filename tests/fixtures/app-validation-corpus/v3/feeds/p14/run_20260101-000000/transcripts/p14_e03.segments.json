"text": "Certainly.",
"char_start": 4884,
"char_end": 4894,
"unit_id": "t0029.u01",
"sent_id": "t0029.s01"
},
{
"start": 1336.86,
"end": 1343.82,
"speaker_label": "Tiago Moreira",
