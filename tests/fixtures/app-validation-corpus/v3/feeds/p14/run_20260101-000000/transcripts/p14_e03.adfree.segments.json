"char_start": 5113,
"char_end": 5166,
"unit_id": "t0033.u01",
"sent_id": "t0033.s02"
},
{
"start": 1380.54,
"end": 1383.72,
"speaker_label": "Tiago Moreira",
"text": "I've observed this pattern repeating itself in three different teams.",
"char_start": 5167,
