"unit_id": "t0010.u01",
"sent_id": "t0010.s01"
},
{
"start": 123.792,
"end": 128.179,
"speaker_label": "Tiago Moreira",
"text": "Spoke & Wrench is one of the platforms where this is clearly evident.",
"char_start": 1656,
"char_end": 1725,
"unit_id": "t0011.u01",
"sent_id": "t0011.s01"
},
{
"start": 128.179,
"end": 132.375,
"speaker_label": "Tiago Moreira",
"text": "I observed this pattern repeating itself in three different teams.",
"char_start": 1726,
"char_end": 1792,
"unit_id": "t0011.u01",
"sent_id": "t0011.s02"
},
{
"start": 132.375,
"end": 134.486,
"speaker_label": "Beatriz Antunes",
"text": "Tell me how you made the decision.",
"char_start": 1810,
"char_end": 1844,
"unit_id": "t0012.u01",
"sent_id": "t0012.s01"
},
{
"start": 134.486,
"end": 138.211,
"speaker_label": "Beatriz Antunes",
"text": "How does the RockShox suspension system fit into this frame?",
"char_start": 1845,
"char_end": 1905,
"unit_id": "t0012.u01",
"sent_id": "t0012.s02"
},
{
"start": 138.211,
"end": 138.855,
"speaker_label": "Tiago Moreira",
"text": "Certainly.",
"char_start": 1921,
"char_end": 1931,
"unit_id": "t0013.u01",
"sent_id": "t0013.s01"
},
{
"start": 138.855,
"end": 143.75,
"speaker_label": "Tiago Moreira",
"text": "The maintenance intervals for the suspension are a risk management decision.",
