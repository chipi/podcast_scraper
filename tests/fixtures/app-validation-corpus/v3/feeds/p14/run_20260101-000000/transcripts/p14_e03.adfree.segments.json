"unit_id": "t0013.u01",
"sent_id": "t0013.s03"
},
{
"start": 149.482,
"end": 151.045,
"speaker_label": "Beatriz Antunes",
"text": "You know what else?",
"char_start": 2116,
"char_end": 2135,
"unit_id": "t0014.u01",
"sent_id": "t0014.s01"
},
{
"start": 151.045,
"end": 156.638,
"speaker_label": "Beatriz Antunes",
"text": "I'll say it plainly: Linear manages my entire engineering operation.",
"char_start": 2136,
"char_end": 2204,
"unit_id": "t0014.u01",
"sent_id": "t0014.s02"
},
{
"start": 156.638,
"end": 162.724,
"speaker_label": "Beatriz Antunes",
"text": "Linear is a task manager designed for speed \u2013 it's built for keyboard use.",
"char_start": 2205,
"char_end": 2279,
"unit_id": "t0014.u01",
"sent_id": "t0014.s03"
},
{
"start": 162.724,
"end": 165.521,
