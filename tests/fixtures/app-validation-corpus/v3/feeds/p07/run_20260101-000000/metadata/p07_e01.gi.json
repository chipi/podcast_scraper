    {
      "id": "quote:bbedcc395995dbf9",
      "properties": {
        "char_end": 1128,
        "char_start": 962,
        "episode_id": "ep-1979e93514355ea6",
        "speaker_id": "person:speaker-02",
        "text": "Here's how I think about it. The most expensive thing about climate is the optionality you lose by delaying. And the second-order effect is the part most people miss.",
        "timestamp_end_ms": 42000,
        "timestamp_start_ms": 36000,
        "transcript_ref": "transcripts/p07_e01.txt"
      },
      "type": "Quote"
    },
    {
      "id": "quote:4a7655b30747968c",
      "properties": {
        "char_end": 1214,
        "char_start": 1142,
        "episode_id": "ep-1979e93514355ea6",
        "speaker_id": "person:speaker-01",
        "text": "Walk me through a concrete example. How does IPCC fit into this picture?",
        "timestamp_end_ms": 48000,
        "timestamp_start_ms": 42000,
        "transcript_ref": "transcripts/p07_e01.txt"
      },
      "type": "Quote"
    },
    {
