        "char_end": 942,
        "char_start": 860,
        "episode_id": "ep-1979e93514355ea6",
        "speaker_id": "person:speaker-01",
        "text": "That's a useful framing. What's the version of the question that actually matters?",
        "timestamp_end_ms": 36000,
        "timestamp_start_ms": 30000,
        "transcript_ref": "transcripts/p07_e01.txt"
      },
      "type": "Quote"
