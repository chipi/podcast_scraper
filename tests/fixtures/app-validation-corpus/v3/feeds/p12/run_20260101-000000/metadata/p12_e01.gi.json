      "properties": {
        "char_end": 565,
        "char_start": 474,
        "episode_id": "ep-8dce4ec000757097",
        "speaker_id": "person:speaker-01",
        "text": "Raconte-moi comment tu as pris la d\u00e9cision. Comment RockShox s'inscrit-il dans ce tableau ?",
