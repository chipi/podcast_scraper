    {
      "id": "quote:d680fdc98554f50d",
      "properties": {
        "char_end": 348,
        "char_start": 240,
        "episode_id": "ep-8dce4ec000757097",
        "speaker_id": "person:speaker-02",
        "text": "Merci, Camille. Avec grand plaisir \u2014 la construction de sentiers est un sujet auquel j'ai beaucoup r\u00e9fl\u00e9chi.",
