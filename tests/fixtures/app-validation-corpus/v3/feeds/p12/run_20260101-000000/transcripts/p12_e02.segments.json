"char_start": 4727,
"char_end": 4796,
"unit_id": "t0029.u01",
"sent_id": "t0029.s04"
},
{
"start": 1353.84,
"end": 1355.58,
"speaker_label": "Camille Dubois",
"text": "Give me a concrete example.",
"char_start": 4813,
"char_end": 4840,
"unit_id": "t0030.u01",
"sent_id": "t0030.s01"
},
{
"start": 1355.64,
"end": 1359.24,
