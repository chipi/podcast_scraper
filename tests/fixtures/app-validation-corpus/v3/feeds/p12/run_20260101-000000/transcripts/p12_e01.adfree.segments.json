"char_end": 5416,
"unit_id": "t0040.u01",
"sent_id": "t0040.s02"
},
{
"start": 252.0,
"end": 255.27,
"speaker_label": "SPEAKER_01",
"text": "Honestly, the most common mistake that beginner builders make is digging with too steep a slope.",
