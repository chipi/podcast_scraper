"unit_id": "t0010.u01",
"sent_id": "t0010.s01"
},
{
"start": 91.633,
"end": 95.637,
"speaker_label": "\u00c9lodie Chevalier",
"text": "The Cascadia Alliance is one of the platforms where this is particularly evident.",
"char_start": 1467,
"char_end": 1548,
"unit_id": "t0011.u01",
"sent_id": "t0011.s01"
},
{
"start": 95.637,
"end": 98.999,
