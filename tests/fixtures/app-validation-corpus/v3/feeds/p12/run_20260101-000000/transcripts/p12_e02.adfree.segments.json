"char_end": 1314,
"unit_id": "t0009.u01",
"sent_id": "t0009.s02"
},
{
"start": 85.082,
"end": 90.005,
"speaker_label": "\u00c9lodie Chevalier",
"text": "If you ignore that, you end up having to rebuild everything from scratch a year later.",
