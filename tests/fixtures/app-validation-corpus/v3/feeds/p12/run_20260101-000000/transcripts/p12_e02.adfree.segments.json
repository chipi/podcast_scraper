"char_end": 1677,
"unit_id": "t0012.u01",
"sent_id": "t0012.s01"
},
{
"start": 101.89,
"end": 104.58,
"speaker_label": "Camille Dubois",
"text": "How does RockShox fit into this picture?",
"char_start": 1678,
"char_end": 1718,
"unit_id": "t0012.u01",
"sent_id": "t0012.s02"
},
{
"start": 104.58,
"end": 105.716,
"speaker_label": "\u00c9lodie Chevalier",
"text": "That's how I see it.",
"char_start": 1737,
"char_end": 1757,
"unit_id": "t0013.u01",
"sent_id": "t0013.s01"
},
{
"start": 105.716,
"end": 113.215,
"speaker_label": "\u00c9lodie Chevalier",
"text": "The erosion patterns on the special stages change the choice of racing line between the reconnaissance runs and the actual race day.",
"char_start": 1758,
"char_end": 1890,
"unit_id": "t0013.u01",
"sent_id": "t0013.s02"
},
{
"start": 113.215,
"end": 117.248,
"speaker_label": "\u00c9lodie Chevalier",
"text": "Once you've internalized that, the rest of the decisions become easier.",
"char_start": 1891,
"char_end": 1962,
"unit_id": "t0013.u01",
"sent_id": "t0013.s03"
},
{
"start": 144.23,
