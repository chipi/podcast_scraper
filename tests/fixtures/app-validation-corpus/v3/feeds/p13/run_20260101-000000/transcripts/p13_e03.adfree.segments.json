"unit_id": "t0037.u01",
"sent_id": "t0037.s01"
},
{
"start": 255.6,
"end": 258.0,
"speaker_label": "Jonas Richter",
"text": "And the second-order effect is the part that most people overlook.",
"char_start": 5547,
"char_end": 5613,
"unit_id": "t0037.u01",
"sent_id": "t0037.s02"
},
{
"start": 258.0,
