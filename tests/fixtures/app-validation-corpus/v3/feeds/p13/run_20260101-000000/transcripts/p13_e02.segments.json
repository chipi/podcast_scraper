"char_end": 293,
"unit_id": "t0002.u01",
"sent_id": "t0002.s01"
},
{
"start": 15.54,
"end": 21.06,
"speaker_label": "Katrin Vogel",
"text": "Linear is the issue tracker built for speed – designed for the keyboard.",
"char_start": 294,
"char_end": 366,
"unit_id": "t0002.u01",
"sent_id": "t0002.s02"
},
{
"start": 21.12,
"end": 22.92,
"speaker_label": "Katrin Vogel",
"text": "Try linear.com today.",
"char_start": 367,
"char_end": 388,
"unit_id": "t0002.u01",
"sent_id": "t0002.s03"
},
{
"start": 22.92,
"end": 31.44,
"speaker_label": "Katrin Vogel",
"text": "Before we get started, Stefan Brandt was on the show and mentioned that drainage is the design decision with the biggest impact.",
"char_start": 389,
"char_end": 517,
"unit_id": "t0002.u01",
"sent_id": "t0002.s04"
},
{
"start": 31.44,
"end": 32.04,
