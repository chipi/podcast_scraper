"char_start": 3663,
"char_end": 3736,
"unit_id": "t0028.u01",
"sent_id": "t0028.s02"
},
{
"start": 1338.96,
"end": 1339.26,
"speaker_label": "Lena Hofmann",
"text": "Certainly.",
