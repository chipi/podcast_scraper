        "char_start": 414,
        "episode_id": "ep-c0ab3bfb1ebdab6d",
        "speaker_id": "person:speaker-01",
        "text": "Erz\u00e4hl mir, wie du die Entscheidung getroffen hast. Wie passt RockShox in dieses Bild?",
        "timestamp_end_ms": 24000,
        "timestamp_start_ms": 18000,
        "transcript_ref": "transcripts/p13_e01.txt"
