        "char_start": 307,
        "episode_id": "ep-c0ab3bfb1ebdab6d",
        "speaker_id": "person:speaker-01",
        "text": "Diese Folge wird unterst\u00fctzt von Strava. Strava ist die Heimat der Athleten. Starte auf strava.com/podcast.",
        "timestamp_end_ms": 18000,
        "timestamp_start_ms": 12000,
