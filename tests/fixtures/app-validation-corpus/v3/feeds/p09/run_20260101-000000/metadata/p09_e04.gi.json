    {
      "id": "quote:176a98ba3c7a0423",
      "properties": {
        "char_end": 694,
        "char_start": 468,
        "episode_id": "ep-4d94c63887afbd1a",
        "speaker_id": "person:speaker-02",
        "text": "Here's how I think about it. Risk lives in the couplings, not the components \u2014 same as reliability. We've seen this play out at teams using BloombergNEF. The framing matters because it tells you which trade-offs you're making.",
        "timestamp_end_ms": 30000,
        "timestamp_start_ms": 24000,
        "transcript_ref": "transcripts/p09_e04.txt"
      },
      "type": "Quote"
    },
    {
      "id": "quote:975e293cf47d1d2e",
      "properties": {
        "char_end": 769,
        "char_start": 700,
        "episode_id": "ep-4d94c63887afbd1a",
        "speaker_id": "person:speaker-01",
        "text": "I want to dig into that. How does BloombergNEF fit into this picture?",
        "timestamp_end_ms": 36000,
        "timestamp_start_ms": 30000,
        "transcript_ref": "transcripts/p09_e04.txt"
      },
      "type": "Quote"
    },
    {
      "id": "quote:c3330be834659fb3",
      "properties": {
        "char_end": 965,
        "char_start": 789,
        "episode_id": "ep-4d94c63887afbd1a",
        "speaker_id": "person:speaker-02",
        "text": "Here's how I think about it. The dangerous risks are the slow correlated ones you can name but discount. If you ignore that, you end up rebuilding it from scratch a year later.",
        "timestamp_end_ms": 42000,
        "timestamp_start_ms": 36000,
        "transcript_ref": "transcripts/p09_e04.txt"
      },
      "type": "Quote"
    },
    {
      "id": "quote:8596401b6251bb59",
      "properties": {
        "char_end": 1299,
        "char_start": 1222,
        "episode_id": "ep-4d94c63887afbd1a",
        "speaker_id": "person:speaker-01",
        "text": "I want to dig into that. What's the most underrated piece of risk management?",
        "timestamp_end_ms": 66000,
        "timestamp_start_ms": 60000,
        "transcript_ref": "transcripts/p09_e04.txt"
      },
      "type": "Quote"
    },
    {
      "id": "quote:4b26edcfa22c2d5a",
      "properties": {
        "char_end": 1531,
        "char_start": 1319,
        "episode_id": "ep-4d94c63887afbd1a",
        "speaker_id": "person:speaker-02",
        "text": "It comes down to this: Risk lives in the couplings, not the components \u2014 same as reliability. We've seen this play out at teams using IPCC. The framing matters because it tells you which trade-offs you're making.",
        "timestamp_end_ms": 72000,
        "timestamp_start_ms": 66000,
        "transcript_ref": "transcripts/p09_e04.txt"
      },
      "type": "Quote"
    },
    {
      "id": "insight:authored-p09_e04-0",
      "properties": {
        "episode_id": "ep-4d94c63887afbd1a",
        "grounded": true,
        "insight_type": "claim",
        "position_hint": 0.5,
        "routing_tag": "surface",
        "salience": 1.0,
        "text": "Risk is a systems property: it lives in the interactions, not the parts.",
        "tier": 3
      },
      "type": "Insight"
    },
