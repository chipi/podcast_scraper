        "char_start": 468,
        "episode_id": "ep-4d94c63887afbd1a",
        "speaker_id": "person:speaker-02",
        "text": "Here's how I think about it. Risk lives in the couplings, not the components \u2014 same as reliability. We've seen this play out at teams using BloombergNEF. The framing matters because it tells you which trade-offs you're making.",
        "timestamp_end_ms": 30000,
        "timestamp_start_ms": 24000,
