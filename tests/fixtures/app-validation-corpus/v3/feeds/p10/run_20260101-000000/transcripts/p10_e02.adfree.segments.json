"sent_id": "t0029.s02"
},
{
"start": 1344.84,
"end": 1347.48,
"speaker_label": "Marta Sol\u00eds",
"text": "We've seen this in teams that use RockShox.",
"char_start": 3934,
"char_end": 3977,
"unit_id": "t0029.u01",
"sent_id": "t0029.s03"
},
{
"start": 1347.54,
