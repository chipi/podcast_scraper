"char_start": 3753,
"char_end": 3827,
"unit_id": "t0028.u01",
"sent_id": "t0028.s02"
},
{
"start": 1339.74,
"end": 1340.1,
"speaker_label": "Marta Sol\u00eds",
"text": "Sure.",
"char_start": 3841,
"char_end": 3846,
"unit_id": "t0029.u01",
"sent_id": "t0029.s01"
},
{
"start": 1340.16,
