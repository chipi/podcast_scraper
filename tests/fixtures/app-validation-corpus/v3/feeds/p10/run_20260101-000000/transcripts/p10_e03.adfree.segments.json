"char_end": 999,
"unit_id": "t0006.u01",
"sent_id": "t0006.s01"
},
{
"start": 70.614,
"end": 74.034,
"speaker_label": "Luc\u00eda Herrera",
"text": "Where do maintenance and transmission mechanics intersect?",
