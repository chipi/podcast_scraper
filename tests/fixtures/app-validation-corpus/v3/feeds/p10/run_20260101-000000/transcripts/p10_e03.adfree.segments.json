"unit_id": "t0002.u01",
"sent_id": "t0002.s03"
},
{
"start": 18.0,
"end": 24.0,
"speaker_label": "Luc\u00eda Herrera",
"text": "Before we get started \u2013 Marta Sol\u00eds was on the previous episode, explaining that tire pressure is more important than suspension adjustments.",
