"char_end": 442,
"unit_id": "t0004.u01",
"sent_id": "t0004.s01"
},
{
"start": 40.398,
"end": 45.693,
"speaker_label": "Luc\u00eda Herrera",
"text": "I want to point something out \u2013 Javier Benavides mentioned this same dynamic a couple of episodes ago.",
