"char_end": 329,
"unit_id": "t0003.u01",
"sent_id": "t0003.s02"
},
{
"start": 34.32,
"end": 39.6,
"speaker_label": "Luc\u00eda Herrera",
"text": "I want to point something out \u2013 Marta Sol\u00eds mentioned this same dynamic a couple of episodes ago.",
