"char_end": 1058,
"unit_id": "t0006.u01",
"sent_id": "t0006.s02"
},
{
"start": 236.22,
"end": 237.06,
"speaker_label": "Diego Ferrer",
"text": "That's how I see it.",
"char_start": 1073,
"char_end": 1093,
"unit_id": "t0007.u01",
"sent_id": "t0007.s01"
},
{
"start": 237.12,
"end": 242.76,
"speaker_label": "Diego Ferrer",
"text": "A bike should feel quiet and predictable so that your attention can remain focused on the trail.",
