"char_end": 1058,
"unit_id": "t0006.u01",
"sent_id": "t0006.s02"
},
{
"start": 74.034,
"end": 75.325,
"speaker_label": "Diego Ferrer",
"text": "That's how I see it.",
"char_start": 1073,
"char_end": 1093,
"unit_id": "t0007.u01",
"sent_id": "t0007.s01"
},
{
"start": 75.325,
"end": 81.524,
"speaker_label": "Diego Ferrer",
"text": "A bike should feel quiet and predictable so that your attention can remain focused on the trail.",
"char_start": 1094,
"char_end": 1190,
"unit_id": "t0007.u01",
"sent_id": "t0007.s02"
},
{
"start": 81.524,
"end": 86.108,
"speaker_label": "Diego Ferrer",
"text": "And the second-order effect is the part that almost everyone overlooks.",
"char_start": 1191,
"char_end": 1262,
