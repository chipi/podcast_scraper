[
{
"start": 0.0,
"end": 2.58,
"speaker_label": "Lucía Herrera",
"text": "Welcome back to Trail Sessions.",
"char_start": 15,
"char_end": 46,
"unit_id": "t0000.u01",
"sent_id": "t0000.s01"
},
{
"start": 2.64,
"end": 8.4,
"speaker_label": "Lucía Herrera",
"text": "Today, we're talking about drivetrain mechanics, and I'm joined by Diego Ferrer, a mechanic at Spoke & Wrench.",
"char_start": 47,
"char_end": 157,
"unit_id": "t0000.u01",
"sent_id": "t0000.s02"
},
{
"start": 8.46,
"end": 10.68,
"speaker_label": "Lucía Herrera",
"text": "Diego Ferrer, thank you for being here.",
"char_start": 158,
"char_end": 197,
"unit_id": "t0000.u01",
"sent_id": "t0000.s03"
},
{
"start": 10.68,
"end": 11.58,
"speaker_label": "Diego Ferrer",
"text": "Thank you, Lucía.",
"char_start": 212,
"char_end": 229,
"unit_id": "t0001.u01",
"sent_id": "t0001.s01"
},
{
"start": 11.64,
"end": 13.32,
"speaker_label": "Diego Ferrer",
"text": "Glad to be back.",
"char_start": 230,
"char_end": 246,
"unit_id": "t0001.u01",
"sent_id": "t0001.s02"
},
{
"start": 13.32,
"end": 16.02,
"speaker_label": "Lucía Herrera",
"text": "Today's episode is sponsored by Notion.",
"char_start": 262,
"char_end": 301,
"unit_id": "t0002.u01",
"sent_id": "t0002.s01"
},
{
"start": 16.08,
"end": 20.28,
"speaker_label": "Lucía Herrera",
"text": "Notion replaces the dozen tools your team uses inconsistently.",
"char_start": 302,
"char_end": 364,
"unit_id": "t0002.u01",
"sent_id": "t0002.s02"
},
{
"start": 20.34,
"end": 21.66,
"speaker_label": "Lucía Herrera",
"text": "Try notion.com today.",
"char_start": 365,
"char_end": 386,
"unit_id": "t0002.u01",
"sent_id": "t0002.s03"
},
{
"start": 21.66,
"end": 31.02,
"speaker_label": "Lucía Herrera",
"text": "Before we get started – Marta Solís was on the previous episode, explaining that tire pressure is more important than suspension adjustments.",
"char_start": 387,
"char_end": 528,
"unit_id": "t0002.u01",
"sent_id": "t0002.s04"
},
{
"start": 31.02,
"end": 31.68,
"speaker_label": "Diego Ferrer",
"text": "Yes, exactly.",
"char_start": 543,
"char_end": 556,
"unit_id": "t0003.u01",
"sent_id": "t0003.s01"
},
{
"start": 31.74,
"end": 34.32,
"speaker_label": "Diego Ferrer",
"text": "And it connects to what we're going to be discussing today.",
"char_start": 557,
"char_end": 616,
"unit_id": "t0003.u01",
"sent_id": "t0003.s02"
},
{
"start": 34.32,
"end": 39.6,
"speaker_label": "Lucía Herrera",
"text": "I want to point something out – Marta Solís mentioned this same dynamic a couple of episodes ago.",
"char_start": 632,
"char_end": 729,
"unit_id": "t0004.u01",
"sent_id": "t0004.s01"
},
{
"start": 39.6,
"end": 45.18,
"speaker_label": "Lucía Herrera",
"text": "I want to point something out – Javier Benavides mentioned this same dynamic a couple of episodes ago.",
"char_start": 730,
"char_end": 832,
"unit_id": "t0004.u01",
"sent_id": "t0004.s02"
},
{
"start": 210.0,
"end": 211.56,
"speaker_label": "Lucía Herrera",
"text": "I want to delve deeper into that.",
"char_start": 833,
"char_end": 866,
"unit_id": "t0004.u01",
"sent_id": "t0004.s03"
},
{
"start": 211.62,
"end": 215.22,
"speaker_label": "Lucía Herrera",
"text": "What's something you used to believe about this that you've since re-evaluated?",
"char_start": 867,
"char_end": 946,
"unit_id": "t0004.u01",
"sent_id": "t0004.s04"
},
{
"start": 215.22,
"end": 224.22,
"speaker_label": "Diego Ferrer",
"text": "It boils down to this: most mysterious creaking noises are resolved by cleaning the contact surfaces and re-tightening them to the specified torque.",
"char_start": 961,
"char_end": 1109,
"unit_id": "t0005.u01",
"sent_id": "t0005.s01"
},
{
"start": 224.28,
"end": 227.28,
"speaker_label": "Diego Ferrer",
"text": "We've seen this happen with equipment that uses Spoke & Wrench.",
"char_start": 1110,
"char_end": 1173,
"unit_id": "t0005.u01",
"sent_id": "t0005.s02"
},
{
"start": 227.34,
"end": 231.12,
"speaker_label": "Diego Ferrer",
"text": "The frame matters because it tells you what compromises you're making.",
"char_start": 1174,
"char_end": 1244,
"unit_id": "t0005.u01",
"sent_id": "t0005.s03"
},
{
"start": 231.12,
"end": 232.38,
"speaker_label": "Lucía Herrera",
"text": "That's a useful framework.",
"char_start": 1260,
"char_end": 1286,
"unit_id": "t0006.u01",
"sent_id": "t0006.s01"
},
{
"start": 232.44,
"end": 236.22,
"speaker_label": "Lucía Herrera",
"text": "Where do maintenance and transmission mechanics intersect?",
"char_start": 1287,
"char_end": 1345,
"unit_id": "t0006.u01",
"sent_id": "t0006.s02"
},
{
"start": 236.22,
"end": 237.06,
"speaker_label": "Diego Ferrer",
"text": "That's how I see it.",
"char_start": 1360,
"char_end": 1380,
"unit_id": "t0007.u01",
"sent_id": "t0007.s01"
},
{
"start": 237.12,
"end": 242.76,
"speaker_label": "Diego Ferrer",
"text": "A bike should feel quiet and predictable so that your attention can remain focused on the trail.",
"char_start": 1381,
"char_end": 1477,
"unit_id": "t0007.u01",
"sent_id": "t0007.s02"
},
{
"start": 242.82,
"end": 247.08,
"speaker_label": "Diego Ferrer",
"text": "And the second-order effect is the part that almost everyone overlooks.",
"char_start": 1478,
"char_end": 1549,
"unit_id": "t0007.u01",
"sent_id": "t0007.s03"
},
{
"start": 247.08,
"end": 248.64,
"speaker_label": "Lucía Herrera",
"text": "I want to delve deeper into that.",
"char_start": 1565,
"char_end": 1598,
"unit_id": "t0008.u01",
"sent_id": "t0008.s01"
},
{
"start": 248.7,
"end": 253.5,
"speaker_label": "Lucía Herrera",
"text": "What is the underlying structural element that most listeners don't have access to?",
"char_start": 1599,
"char_end": 1682,
"unit_id": "t0008.u01",
"sent_id": "t0008.s02"
},
{
"start": 253.5,
"end": 253.86,
"speaker_label": "Diego Ferrer",
"text": "Sure.",
"char_start": 1697,
"char_end": 1702,
"unit_id": "t0009.u01",
"sent_id": "t0009.s01"
},
{
"start": 253.92,
"end": 260.04,
"speaker_label": "Diego Ferrer",
"text": "Chain wear is the best early indicator of when you'll need to replace the cassette.",
"char_start": 1703,
"char_end": 1786,
"unit_id": "t0009.u01",
"sent_id": "t0009.s02"
},
{
"start": 260.1,
"end": 263.1,
"speaker_label": "Diego Ferrer",
"text": "We've seen this in equipment that uses Spoke & Wrench.",
"char_start": 1787,
"char_end": 1841,
"unit_id": "t0009.u01",
"sent_id": "t0009.s03"
},
{
"start": 263.16,
"end": 266.94,
"speaker_label": "Diego Ferrer",
"text": "The frame matters because it tells you what compromises you're making.",
"char_start": 1842,
"char_end": 1912,
"unit_id": "t0009.u01",
"sent_id": "t0009.s04"
},
{
"start": 266.94,
"end": 268.44,
"speaker_label": "Lucía Herrera",
"text": "Tell me more about that.",
"char_start": 1928,
"char_end": 1952,
"unit_id": "t0010.u01",
"sent_id": "t0010.s01"
},
{
"start": 268.44,
"end": 272.7,
"speaker_label": "Diego Ferrer",
"text": "Spoke & Wrench is one of the platforms where this is clearly evident.",
"char_start": 1967,
"char_end": 2036,
"unit_id": "t0011.u01",
"sent_id": "t0011.s01"
},
{
"start": 272.76,
"end": 276.18,
"speaker_label": "Diego Ferrer",
"text": "I have observed this pattern repeating itself in three different teams.",
"char_start": 2037,
"char_end": 2108,
"unit_id": "t0011.u01",
"sent_id": "t0011.s02"
},
{
"start": 276.18,
"end": 278.22,
"speaker_label": "Lucía Herrera",
"text": "Tell me how you made the decision.",
"char_start": 2124,
"char_end": 2158,
"unit_id": "t0012.u01",
"sent_id": "t0012.s01"
},
{
"start": 278.28,
"end": 280.62,
"speaker_label": "Lucía Herrera",
"text": "How does RockShox fit into this landscape?",
"char_start": 2159,
"char_end": 2201,
"unit_id": "t0012.u01",
"sent_id": "t0012.s02"
},
{
"start": 280.62,
"end": 280.98,
"speaker_label": "Diego Ferrer",
"text": "Sure.",
"char_start": 2216,
"char_end": 2221,
"unit_id": "t0013.u01",
"sent_id": "t0013.s01"
},
{
"start": 281.04,
"end": 286.02,
"speaker_label": "Diego Ferrer",
"text": "The service intervals for the suspension are a risk management decision.",
"char_start": 2222,
"char_end": 2294,
"unit_id": "t0013.u01",
"sent_id": "t0013.s02"
},
{
"start": 286.08,
"end": 290.04,
"speaker_label": "Diego Ferrer",
"text": "If you ignore that, you'll end up rebuilding it from scratch a year later.",
"char_start": 2295,
"char_end": 2369,
"unit_id": "t0013.u01",
"sent_id": "t0013.s03"
},
{
"start": 290.04,
"end": 290.7,
"speaker_label": "Lucía Herrera",
"text": "You know what?",
"char_start": 2385,
"char_end": 2399,
"unit_id": "t0014.u01",
"sent_id": "t0014.s01"
},
{
"start": 290.76,
"end": 294.48,
"speaker_label": "Lucía Herrera",
"text": "I'm just saying: Linear handles my entire engineering operation.",
"char_start": 2400,
"char_end": 2464,
"unit_id": "t0014.u01",
"sent_id": "t0014.s02"
},
{
"start": 294.54,
"end": 299.64,
"speaker_label": "Lucía Herrera",
"text": "Linear is the incident management tool built for speed – designed for keyboard use.",
"char_start": 2465,
"char_end": 2548,
"unit_id": "t0014.u01",
"sent_id": "t0014.s03"
},
{
"start": 299.7,
"end": 302.1,
"speaker_label": "Lucía Herrera",
"text": "Use the link in the episode notes.",
"char_start": 2549,
"char_end": 2583,
"unit_id": "t0014.u01",
"sent_id": "t0014.s04"
},
{
"start": 720.0,
"end": 723.6,
