"char_end": 5932,
"unit_id": "t0043.u01",
"sent_id": "t0043.s01"
},
{
"start": 1689.66,
"end": 1690.98,
"speaker_label": "SPEAKER_01",
"text": "Everything else is iteration.",
"char_start": 5933,
"char_end": 5962,
