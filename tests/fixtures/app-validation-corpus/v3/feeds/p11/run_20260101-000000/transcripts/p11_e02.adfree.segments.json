"char_end": 809,
"unit_id": "t0006.u01",
"sent_id": "t0006.s01"
},
{
"start": 60.256,
"end": 63.016,
"speaker_label": "Giulia Ferrara",
"text": "Where do soil erosion and enduro racing intersect?",
"char_start": 810,
"char_end": 860,
"unit_id": "t0006.u01",
"sent_id": "t0006.s02"
},
{
"start": 63.016,
"end": 63.624,
"speaker_label": "Chiara Ricci",
"text": "Certainly.",
"char_start": 875,
"char_end": 885,
"unit_id": "t0007.u01",
"sent_id": "t0007.s01"
},
{
"start": 63.624,
"end": 69.885,
"speaker_label": "Chiara Ricci",
"text": "Tire pressure and the choice of tire casing often matter more than minor adjustments to the suspension.",
"char_start": 886,
"char_end": 989,
"unit_id": "t0007.u01",
"sent_id": "t0007.s02"
},
{
"start": 69.885,
"end": 74.627,
"speaker_label": "Chiara Ricci",
"text": "The framing is important because it tells you what compromises you are making.",
"char_start": 990,
"char_end": 1068,
"unit_id": "t0007.u01",
"sent_id": "t0007.s03"
},
{
"start": 74.627,
"end": 75.964,
"speaker_label": "Giulia Ferrara",
"text": "Let's start from there.",
"char_start": 1085,
"char_end": 1108,
"unit_id": "t0008.u01",
"sent_id": "t0008.s01"
},
{
"start": 75.964,
"end": 78.871,
"speaker_label": "Giulia Ferrara",
"text": "Where do soil erosion and enduro racing intersect?",
"char_start": 1109,
"char_end": 1159,
"unit_id": "t0008.u01",
"sent_id": "t0008.s02"
},
{
"start": 78.871,
"end": 85.643,
"speaker_label": "Chiara Ricci",
"text": "Honestly, risk management in racing isn't about avoiding crashes \u2013 it's about choosing which crashes are survivable.",
"char_start": 1174,
"char_end": 1290,
"unit_id": "t0009.u01",
"sent_id": "t0009.s01"
},
{
"start": 85.643,
"end": 88.095,
"speaker_label": "Chiara Ricci",
"text": "We've seen this in teams that use Shimano.",
