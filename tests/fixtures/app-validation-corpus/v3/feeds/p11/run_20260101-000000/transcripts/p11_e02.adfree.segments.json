"sent_id": "t0003.s01"
},
{
"start": 32.042,
"end": 34.657,
"speaker_label": "Chiara Ricci",
"text": "And that connects to what we're discussing today.",
"char_start": 290,
"char_end": 339,
"unit_id": "t0003.u01",
"sent_id": "t0003.s02"
},
{
"start": 34.657,
"end": 40.628,
