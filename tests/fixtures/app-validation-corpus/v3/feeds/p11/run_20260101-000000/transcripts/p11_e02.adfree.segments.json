"char_end": 1917,
"unit_id": "t0013.u01",
"sent_id": "t0013.s02"
},
{
"start": 116.948,
"end": 120.769,
"speaker_label": "Chiara Ricci",
"text": "Once you internalize that, the rest of the decisions become easier.",
"char_start": 1918,
"char_end": 1985,
"unit_id": "t0013.u01",
"sent_id": "t0013.s03"
},
{
