"sent_id": "t0020.s01"
},
{
"start": 200.861,
"end": 203.792,
"speaker_label": "Giulia Ferrara",
"text": "What were your initial thoughts on this topic, and how have they changed since then?",
"char_start": 3590,
"char_end": 3674,
"unit_id": "t0020.u01",
"sent_id": "t0020.s02"
},
{
"start": 203.792,
