"sent_id": "t0017.s01"
},
{
"start": 170.672,
"end": 177.24,
"speaker_label": "Luca Moretti",
"text": "Most mysterious creaking noises are resolved by cleaning the contact surfaces and tightening them to the specified torque.",
"char_start": 3004,
"char_end": 3126,
"unit_id": "t0017.u01",
"sent_id": "t0017.s02"
},
{
"start": 177.24,
"end": 180.471,
"speaker_label": "Luca Moretti",
"text": "We've seen this happen in teams that use Shimano components.",
"char_start": 3127,
"char_end": 3187,
"unit_id": "t0017.u01",
"sent_id": "t0017.s03"
},
{
"start": 180.471,
"end": 183.809,
"speaker_label": "Luca Moretti",
