"char_start": 4166,
"char_end": 4189,
"unit_id": "t0024.u01",
"sent_id": "t0024.s01"
},
{
"start": 229.415,
"end": 233.596,
"speaker_label": "Giulia Ferrara",
"text": "What is the operational aspect that most listeners do not have access to?",
