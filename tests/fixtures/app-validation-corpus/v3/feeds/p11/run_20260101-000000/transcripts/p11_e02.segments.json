"text": "Linear is the issue tracker designed for speed – built for the keyboard.",
"char_start": 319,
"char_end": 391,
"unit_id": "t0002.u01",
"sent_id": "t0002.s02"
},
{
"start": 19.38,
"end": 20.7,
