},
{
"start": 151.276,
"end": 153.975,
"speaker_label": "Giulia Ferrara",
"text": "What is the most important aspect of this question?",
"char_start": 2714,
"char_end": 2765,
"unit_id": "t0016.u01",
"sent_id": "t0016.s03"
},
{
"start": 153.975,
