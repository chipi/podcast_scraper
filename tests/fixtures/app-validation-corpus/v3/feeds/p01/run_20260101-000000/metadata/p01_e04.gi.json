        "char_start": 1073,
        "episode_id": "ep-de59d003651d9e5d",
        "speaker_id": "person:speaker-01",
        "text": "Thanks to Peak Design for backing the show. Peak Design builds bags and straps designed by people who actually ride.",
        "timestamp_end_ms": 54000,
        "timestamp_start_ms": 48000,
        "transcript_ref": "transcripts/p01_e04.txt"
      },
      "type": "Quote"
    },
