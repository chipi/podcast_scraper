        "insight_type": "claim",
        "position_hint": 0.5,
        "routing_tag": "surface",
        "salience": 1.0,
        "text": "Risk management in production is naming the risk before it names you.",
        "tier": 3
      },
      "type": "Insight"
    },
    {
      "id": "quote:authored-p02_e04-1",
      "properties": {
        "char_end": 1218,
        "char_start": 963,
        "episode_id": "ep-18ede6ffbd63f18f",
        "speaker_id": "person:priya-nair",
        "text": "It really is the same discipline. Risk management in production is mostly about naming the risk before it names you. The outage you can describe in advance is the one you can design around; the one that takes you down is the one nobody would say out loud.",
        "timestamp_end_ms": 97686,
        "timestamp_start_ms": 78155,
