        "speaker_id": "person:speaker-01",
        "text": "Walk me through a concrete example. How does Linear fit into this picture?",
        "timestamp_end_ms": 54000,
        "timestamp_start_ms": 48000,
        "transcript_ref": "transcripts/p02_e02.txt"
