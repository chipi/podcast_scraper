        "position_hint": 0.2,
        "routing_tag": "surface",
        "salience": 0.7667,
        "text": "Let me give you the version I actually believe. Threat modeling is a framing exercise \u2014 frame the decision wrong and you build the wrong defenses. We've seen this play out at teams using Notion. On\u2026",
        "tier": 2
      },
      "type": "Insight"
