    {
      "id": "insight:1d60d05c768c1c43",
      "properties": {
        "episode_id": "ep-d8cc458a5f0049a8",
        "grounded": true,
        "insight_type": "observation",
        "position_hint": 0.35,
        "routing_tag": "surface",
        "salience": 0.7667,
        "text": "It comes down to this: Security incidents are reliability incidents. We've seen this play out at teams using Sentry. And the second-order effect is the part most people miss.",
        "tier": 2
      },
      "type": "Insight"
    },
    {
      "id": "insight:f0317228c2ef2e49",
      "properties": {
