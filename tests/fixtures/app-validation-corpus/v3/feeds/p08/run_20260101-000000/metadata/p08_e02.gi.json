        "char_start": 996,
        "episode_id": "ep-64ef09a7ee543045",
        "speaker_id": "person:speaker-01",
        "text": "Push back on the conventional wisdom for me. What's something you used to believe about this that you've revised?",
        "timestamp_end_ms": 48000,
        "timestamp_start_ms": 42000,
        "transcript_ref": "transcripts/p08_e02.txt"
