    {
      "id": "insight:bcd5c55df58f8228",
      "properties": {
        "episode_id": "ep-64ef09a7ee543045",
        "grounded": true,
        "insight_type": "recommendation",
        "position_hint": 0.5,
        "routing_tag": "surface",
        "salience": 0.7667,
        "text": "It comes down to this: Mispronunciation is a high-signal mistake \u2014 it tells listeners 'this person isn't paying attention'. We've seen this play out at teams using BBC. The framing matters because\u2026",
        "tier": 2
      },
      "type": "Insight"
