      "properties": {
        "char_end": 714,
        "char_start": 619,
        "episode_id": "ep-64ef09a7ee543045",
        "speaker_id": "person:speaker-01",
        "text": "What does the failure mode look like? What's the version of the question that actually matters?",
        "timestamp_end_ms": 36000,
        "timestamp_start_ms": 30000,
        "transcript_ref": "transcripts/p08_e02.txt"
      },
      "type": "Quote"
    },
    {
      "id": "quote:d5b1a6ce8135a7b7",
      "properties": {
        "char_end": 977,
        "char_start": 736,
        "episode_id": "ep-64ef09a7ee543045",
        "speaker_id": "person:speaker-02",
        "text": "It comes down to this: Mispronunciation is a high-signal mistake \u2014 it tells listeners 'this person isn't paying attention'. We've seen this play out at teams using BBC. The framing matters because it tells you which trade-offs you're making.",
        "timestamp_end_ms": 42000,
        "timestamp_start_ms": 36000,
        "transcript_ref": "transcripts/p08_e02.txt"
      },
      "type": "Quote"
    },
    {
