        "char_end": 1636,
        "char_start": 1562,
        "episode_id": "ep-64ef09a7ee543045",
        "speaker_id": "person:speaker-01",
        "text": "I want to dig into that. What's the most underrated piece of public radio?",
        "timestamp_end_ms": 78000,
        "timestamp_start_ms": 72000,
        "transcript_ref": "transcripts/p08_e02.txt"
