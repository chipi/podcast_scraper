        "episode_id": "ep-b3570c1ceb5eca41",
        "speaker_id": "person:speaker-01",
        "text": "Walk me through a concrete example. What's the most underrated piece of journalism?",
        "timestamp_end_ms": 66000,
        "timestamp_start_ms": 60000,
        "transcript_ref": "transcripts/p08_e03.txt"
      },
      "type": "Quote"
    },
