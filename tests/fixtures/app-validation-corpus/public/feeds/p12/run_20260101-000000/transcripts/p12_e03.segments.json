  {
    "char_end": 1161,
    "char_start": 1084,
    "end": 67.009,
    "sent_id": "t0005.s03",
    "start": 63.007,
    "text": "The framing is important because it tells you what compromises you're making.",
    "unit_id": "t0005.u01"
  },
