  },
  {
    "char_end": 1268,
    "char_start": 1192,
    "end": 71.832,
    "sent_id": "t0006.s02",
    "start": 68.341,
    "text": "Where do the fields of human resources and transmission mechanics intersect?",
    "unit_id": "t0006.u01"
  },
  {
    "char_end": 1289,
    "char_start": 1269,
    "end": 73.005,
    "sent_id": "t0007.s01",
    "start": 71.832,
    "text": "That's how I see it.",
