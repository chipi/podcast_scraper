        "episode_id": "d2fb36a0-6f97-55ee-a67a-e97dba3b7f27",
        "speaker_id": "person:speaker-01",
        "text": "That's a real shift. Worth pulling on.",
        "timestamp_end_ms": 42000,
        "timestamp_start_ms": 36000,
        "transcript_ref": "transcripts/p02_e03.txt"
      },
      "type": "Quote"
    },
    {
      "id": "quote:c7f52d170b8c655c",
      "properties": {
        "char_end": 871,
        "char_start": 731,
        "episode_id": "d2fb36a0-6f97-55ee-a67a-e97dba3b7f27",
        "speaker_id": "person:speaker-01",
        "text": "Real talk: Sentry is the tool I'd pay double for. Not an ad \u2014 they're not paying us. I just think it's the best in class for error tracking.",
