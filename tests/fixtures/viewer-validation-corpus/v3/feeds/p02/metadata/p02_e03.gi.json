      "properties": {
        "char_end": 453,
        "char_start": 341,
        "episode_id": "d2fb36a0-6f97-55ee-a67a-e97dba3b7f27",
        "speaker_id": "person:speaker-01",
        "text": "Before we get into it \u2014 I was last on the show talking about on-call rotations. The pattern shows up again here.",
        "timestamp_end_ms": 24000,
        "timestamp_start_ms": 18000,
        "transcript_ref": "transcripts/p02_e03.txt"
      },
      "type": "Quote"
    },
    {
      "id": "quote:a1b64e796d6c32c3",
      "properties": {
        "char_end": 685,
        "char_start": 524,
        "episode_id": "d2fb36a0-6f97-55ee-a67a-e97dba3b7f27",
        "speaker_id": "person:speaker-02",
        "text": "I used to argue for a single central security team. After the 2024 webhook incident I changed my mind \u2014 embedded ownership beats a central gatekeeper every time.",
        "timestamp_end_ms": 36000,
        "timestamp_start_ms": 30000,
        "transcript_ref": "transcripts/p02_e03.txt"
      },
      "type": "Quote"
    },
