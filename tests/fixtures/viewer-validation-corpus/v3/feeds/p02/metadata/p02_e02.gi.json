        "char_start": 613,
        "episode_id": "096240a2-e115-5a3c-98b4-2d852b096eda",
        "speaker_id": "person:speaker-01",
        "text": "I want to flag something \u2014 Priya Nayar mentioned this same dynamic a couple episodes back.",
        "timestamp_end_ms": 36000,
        "timestamp_start_ms": 30000,
        "transcript_ref": "transcripts/p02_e02.txt"
