    {
      "id": "quote:696efb63695f2635",
      "properties": {
        "char_end": 785,
        "char_start": 703,
        "episode_id": "096240a2-e115-5a3c-98b4-2d852b096eda",
        "speaker_id": "person:speaker-01",
        "text": "That's a useful framing. What's the version of the question that actually matters?",
        "timestamp_end_ms": 42000,
        "timestamp_start_ms": 36000,
        "transcript_ref": "transcripts/p02_e02.txt"
      },
      "type": "Quote"
    },
    {
      "id": "quote:78689b07f21f0c90",
      "properties": {
        "char_end": 987,
        "char_start": 802,
        "episode_id": "096240a2-e115-5a3c-98b4-2d852b096eda",
        "speaker_id": "person:speaker-02",
        "text": "Honestly, A great RFC starts with context and constraints, then options. We've seen this play out at teams using Notion. Once you internalize that, the rest of the decisions get easier.",
        "timestamp_end_ms": 48000,
        "timestamp_start_ms": 42000,
