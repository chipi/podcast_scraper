    {
      "id": "quote:8bd321c005598fcb",
      "properties": {
        "char_end": 356,
        "char_start": 233,
        "episode_id": "799ba6c0-3117-50e1-8c97-c2d8b695cce4",
        "speaker_id": "person:speaker-01",
        "text": "Today's episode is sponsored by Linear. Linear is the issue tracker built for speed \u2014 keyboard-first. Try linear.com today.",
        "timestamp_end_ms": 18000,
        "timestamp_start_ms": 12000,
        "transcript_ref": "transcripts/p01_e02.txt"
      },
      "type": "Quote"
    },
    {
      "id": "quote:b0df330647573c5d",
      "properties": {
        "char_end": 481,
        "char_start": 356,
        "episode_id": "799ba6c0-3117-50e1-8c97-c2d8b695cce4",
        "speaker_id": "person:speaker-01",
        "text": "Before we get into it \u2014 Liam Verbeck was on the show talking about how drainage is the single highest-leverage design choice.",
        "timestamp_end_ms": 24000,
        "timestamp_start_ms": 18000,
        "transcript_ref": "transcripts/p01_e02.txt"
      },
      "type": "Quote"
    },
    {
      "id": "quote:32a9cbcddb400b51",
      "properties": {
        "char_end": 653,
        "char_start": 562,
        "episode_id": "799ba6c0-3117-50e1-8c97-c2d8b695cce4",
        "speaker_id": "person:speaker-01",
        "text": "I want to flag something \u2014 Liam Verbeck mentioned this same dynamic a couple episodes back.",
        "timestamp_end_ms": 36000,
        "timestamp_start_ms": 30000,
        "transcript_ref": "transcripts/p01_e02.txt"
      },
      "type": "Quote"
    },
    {
      "id": "quote:ac34f9ae6b9d87ae",
      "properties": {
        "char_end": 739,
        "char_start": 653,
        "episode_id": "799ba6c0-3117-50e1-8c97-c2d8b695cce4",
        "speaker_id": "person:speaker-01",
        "text": "Walk me through a concrete example. Where do soil erosion and enduro racing intersect?",
        "timestamp_end_ms": 42000,
        "timestamp_start_ms": 36000,
        "transcript_ref": "transcripts/p01_e02.txt"
      },
      "type": "Quote"
    },
    {
      "id": "quote:a1d7808e9a032c10",
      "properties": {
        "char_end": 952,
        "char_start": 755,
        "episode_id": "799ba6c0-3117-50e1-8c97-c2d8b695cce4",
        "speaker_id": "person:speaker-02",
        "text": "Honestly, Speed comes from braking earlier and smoother, not from taking bigger risks. We've seen this play out at teams using RockShox. I've watched this pattern hold across three different teams.",
        "timestamp_end_ms": 48000,
        "timestamp_start_ms": 42000,
        "transcript_ref": "transcripts/p01_e02.txt"
      },
      "type": "Quote"
    }
