    {
      "id": "insight:7cc4cbf5f2e79fce",
      "properties": {
        "episode_id": "a6d9a4a0-6c21-5c3e-ba1f-3fb5fdb79207",
        "grounded": true,
        "insight_type": "recommendation",
        "position_hint": 0.5,
        "text": "I'm Alex Morgan, and my guest is Dr."
      },
