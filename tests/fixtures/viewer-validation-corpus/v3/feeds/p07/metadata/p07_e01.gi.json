    {
      "id": "insight:5de70b4a73d706e3",
      "properties": {
        "episode_id": "5ef53e66-e083-5fcb-b555-a3814ebb6b39",
        "grounded": true,
        "insight_type": "recommendation",
        "position_hint": 0.5,
        "text": "Elena Fischer, sustainability researcher and systems thinker."
      },
