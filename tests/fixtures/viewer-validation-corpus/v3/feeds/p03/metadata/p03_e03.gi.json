      "properties": {
        "char_end": 514,
        "char_start": 390,
        "episode_id": "9a2d05c1-8854-5ae6-8ad0-14fcf37d1de9",
        "speaker_id": "person:speaker-01",
        "text": "Before we get into it \u2014 Marco was on episode 1 walking through wreck planning \u2014 the same discipline applies to reef surveys.",
        "timestamp_end_ms": 24000,
        "timestamp_start_ms": 18000,
        "transcript_ref": "transcripts/p03_e03.txt"
