      "properties": {
        "char_end": 684,
        "char_start": 600,
        "episode_id": "9a2d05c1-8854-5ae6-8ad0-14fcf37d1de9",
        "speaker_id": "person:speaker-01",
        "text": "I want to flag something \u2014 Marco mentioned this same dynamic a couple episodes back.",
        "timestamp_end_ms": 36000,
        "timestamp_start_ms": 30000,
        "transcript_ref": "transcripts/p03_e03.txt"
