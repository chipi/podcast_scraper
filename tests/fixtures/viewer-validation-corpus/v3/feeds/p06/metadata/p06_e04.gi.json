    {
      "id": "quote:668c72247c795115",
      "properties": {
        "char_end": 445,
        "char_start": 368,
        "episode_id": "55e302e4-3319-59f2-8c17-fde08bffd658",
        "speaker_id": "person:speaker-01",
        "text": "Take me through the decision. Where do dialogue and cultural drift intersect?",
        "timestamp_end_ms": 24000,
        "timestamp_start_ms": 18000,
        "transcript_ref": "transcripts/p06_e04.txt"
      },
      "type": "Quote"
    },
    {
      "id": "quote:cdf875c6f5c208bf",
      "properties": {
        "char_end": 634,
        "char_start": 459,
        "episode_id": "55e302e4-3319-59f2-8c17-fde08bffd658",
        "speaker_id": "person:speaker-02",
        "text": "Honestly, Culture is a system that never sits still. We've seen this play out at teams using Substack. The framing matters because it tells you which trade-offs you're making.",
        "timestamp_end_ms": 30000,
        "timestamp_start_ms": 24000,
        "transcript_ref": "transcripts/p06_e04.txt"
      },
      "type": "Quote"
    },
    {
      "id": "quote:a624e1ef6da1be3a",
      "properties": {
        "char_end": 740,
        "char_start": 640,
        "episode_id": "55e302e4-3319-59f2-8c17-fde08bffd658",
        "speaker_id": "person:speaker-01",
        "text": "Walk me through a concrete example. What's the structural angle most listeners don't have access to?",
        "timestamp_end_ms": 36000,
        "timestamp_start_ms": 30000,
        "transcript_ref": "transcripts/p06_e04.txt"
      },
      "type": "Quote"
    },
    {
      "id": "quote:92c24d90fe8d2b57",
      "properties": {
        "char_end": 908,
        "char_start": 754,
        "episode_id": "55e302e4-3319-59f2-8c17-fde08bffd658",
        "speaker_id": "person:speaker-02",
        "text": "Let me give you the version I actually believe. You can't grip drift; you can only notice it. I've watched this pattern hold across three different teams.",
        "timestamp_end_ms": 42000,
        "timestamp_start_ms": 36000,
        "transcript_ref": "transcripts/p06_e04.txt"
      },
      "type": "Quote"
