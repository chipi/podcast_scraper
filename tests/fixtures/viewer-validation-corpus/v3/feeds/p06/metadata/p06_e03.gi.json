    {
      "id": "quote:30387fc2b1625c11",
      "properties": {
        "char_end": 608,
        "char_start": 433,
        "episode_id": "01835c28-431e-5b5a-adbb-5ec01411a299",
        "speaker_id": "person:speaker-02",
        "text": "It comes down to this: Meaning drifts faster than anyone admits. We've seen this play out at teams using Substack. I've watched this pattern hold across three different teams.",
        "timestamp_end_ms": 30000,
        "timestamp_start_ms": 24000,
        "transcript_ref": "transcripts/p06_e03.txt"
      },
      "type": "Quote"
