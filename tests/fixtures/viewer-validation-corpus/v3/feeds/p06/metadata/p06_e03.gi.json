        "char_start": 319,
        "episode_id": "01835c28-431e-5b5a-adbb-5ec01411a299",
        "speaker_id": "person:speaker-01",
        "text": "Walk me through a concrete example. What's the structural angle most listeners don't have access to?",
        "timestamp_end_ms": 24000,
        "timestamp_start_ms": 18000,
        "transcript_ref": "transcripts/p06_e03.txt"
      },
