        "char_start": 614,
        "episode_id": "01835c28-431e-5b5a-adbb-5ec01411a299",
        "speaker_id": "person:speaker-01",
        "text": "Walk me through a concrete example. What's the version of the question that actually matters?",
        "timestamp_end_ms": 36000,
        "timestamp_start_ms": 30000,
        "transcript_ref": "transcripts/p06_e03.txt"
      },
      "type": "Quote"
    },
