    {
      "id": "quote:fa5a33e183b092b5",
      "properties": {
        "char_end": 299,
        "char_start": 202,
        "episode_id": "22aa61d4-d535-5e72-ae9b-d44d9a3054d1",
        "speaker_id": "person:speaker-02",
        "text": "Thanks, Sam. Excited for this one \u2014 systems thinking is something I've been thinking about a lot.",
        "timestamp_end_ms": 12000,
        "timestamp_start_ms": 6000,
        "transcript_ref": "transcripts/p09_e01.txt"
      },
      "type": "Quote"
    },
    {
      "id": "person:speaker-01",
      "properties": {
        "name": "Sam"
      },
      "type": "Person"
    },
    {
      "id": "quote:a3e6c15d76b91783",
      "properties": {
        "char_end": 423,
        "char_start": 305,
        "episode_id": "22aa61d4-d535-5e72-ae9b-d44d9a3054d1",
        "speaker_id": "person:speaker-01",
        "text": "Today's episode is sponsored by Notion. Notion replaces the dozen tools your team is half-using. Try notion.com today.",
        "timestamp_end_ms": 18000,
        "timestamp_start_ms": 12000,
        "transcript_ref": "transcripts/p09_e01.txt"
      },
      "type": "Quote"
    },
    {
      "id": "quote:e0ad9c07dee7a889",
      "properties": {
        "char_end": 570,
        "char_start": 443,
        "episode_id": "22aa61d4-d535-5e72-ae9b-d44d9a3054d1",
        "speaker_id": "person:speaker-02",
        "text": "In our 2024 conversation I was more optimistic about top-down interventions. I've revised that \u2014 the work happens at the seams.",
        "timestamp_end_ms": 24000,
        "timestamp_start_ms": 18000,
        "transcript_ref": "transcripts/p09_e01.txt"
      },
      "type": "Quote"
    },
    {
      "id": "quote:8b06b915bceec426",
      "properties": {
        "char_end": 614,
        "char_start": 576,
        "episode_id": "22aa61d4-d535-5e72-ae9b-d44d9a3054d1",
        "speaker_id": "person:speaker-01",
        "text": "That's a real shift. Worth pulling on.",
        "timestamp_end_ms": 30000,
        "timestamp_start_ms": 24000,
        "transcript_ref": "transcripts/p09_e01.txt"
      },
      "type": "Quote"
    },
    {
      "id": "quote:1335c36c3cf818f9",
      "properties": {
        "char_end": 680,
        "char_start": 614,
        "episode_id": "22aa61d4-d535-5e72-ae9b-d44d9a3054d1",
        "speaker_id": "person:speaker-01",
        "text": "I want to dig into that. How does Bloomberg fit into this picture?",
        "timestamp_end_ms": 36000,
        "timestamp_start_ms": 30000,
        "transcript_ref": "transcripts/p09_e01.txt"
      },
      "type": "Quote"
    },
    {
      "id": "quote:8a3af1e1e6ae264d",
      "properties": {
        "char_end": 936,
        "char_start": 700,
        "episode_id": "22aa61d4-d535-5e72-ae9b-d44d9a3054d1",
        "speaker_id": "person:speaker-02",
        "text": "Let me give you the version I actually believe. Two years of systems-thinking work has made me more humble about leverage points. We've seen this play out at teams using IPCC. I've watched this pattern hold across three different teams.",
        "timestamp_end_ms": 42000,
        "timestamp_start_ms": 36000,
        "transcript_ref": "transcripts/p09_e01.txt"
      },
      "type": "Quote"
    }
