    {
      "id": "person:speaker-02",
      "properties": {
        "name": "Renee Montagne-Park"
      },
      "type": "Person"
    },
    {
      "id": "quote:9fc8dd3483140200",
      "properties": {
        "char_end": 245,
        "char_start": 202,
        "episode_id": "1b3a6ea0-3cfe-5f9b-a562-a0e49e2b4130",
        "speaker_id": "person:speaker-02",
        "text": "Thanks, A. correspondent. Great to be back.",
        "timestamp_end_ms": 12000,
        "timestamp_start_ms": 6000,
        "transcript_ref": "transcripts/p08_e04.txt"
      },
      "type": "Quote"
    },
    {
      "id": "person:speaker-01",
      "properties": {
        "name": "A. correspondent"
      },
      "type": "Person"
    },
    {
      "id": "quote:4141d1f93dfeec0e",
      "properties": {
        "char_end": 397,
        "char_start": 264,
        "episode_id": "1b3a6ea0-3cfe-5f9b-a562-a0e49e2b4130",
        "speaker_id": "person:speaker-01",
        "text": "This episode is brought to you by Notion. Notion replaces the dozen tools your team is half-using. Get started at notion.com/podcast.",
        "timestamp_end_ms": 18000,
        "timestamp_start_ms": 12000,
        "transcript_ref": "transcripts/p08_e04.txt"
      },
      "type": "Quote"
    },
    {
      "id": "quote:897d8d1e666ed5cb",
      "properties": {
        "char_end": 499,
        "char_start": 397,
        "episode_id": "1b3a6ea0-3cfe-5f9b-a562-a0e49e2b4130",
        "speaker_id": "person:speaker-01",
        "text": "Push back on the conventional wisdom for me. What's the version of the question that actually matters?",
        "timestamp_end_ms": 24000,
        "timestamp_start_ms": 18000,
        "transcript_ref": "transcripts/p08_e04.txt"
      },
      "type": "Quote"
    },
    {
      "id": "quote:ee3ac130d4e77a34",
      "properties": {
        "char_end": 700,
        "char_start": 521,
        "episode_id": "1b3a6ea0-3cfe-5f9b-a562-a0e49e2b4130",
        "speaker_id": "person:speaker-02",
        "text": "Honestly, A correction is a reliability signal, not a failure. We've seen this play out at teams using BBC. If you ignore that, you end up rebuilding it from scratch a year later.",
        "timestamp_end_ms": 30000,
        "timestamp_start_ms": 24000,
        "transcript_ref": "transcripts/p08_e04.txt"
      },
      "type": "Quote"
    },
    {
      "id": "quote:1b8556c3c7662ca3",
      "properties": {
        "char_end": 814,
        "char_start": 719,
        "episode_id": "1b3a6ea0-3cfe-5f9b-a562-a0e49e2b4130",
        "speaker_id": "person:speaker-01",
        "text": "What does the failure mode look like? What's the version of the question that actually matters?",
        "timestamp_end_ms": 36000,
        "timestamp_start_ms": 30000,
        "transcript_ref": "transcripts/p08_e04.txt"
      },
      "type": "Quote"
    },
    {
      "id": "quote:74920e33540c8801",
      "properties": {
        "char_end": 1010,
        "char_start": 836,
        "episode_id": "1b3a6ea0-3cfe-5f9b-a562-a0e49e2b4130",
        "speaker_id": "person:speaker-02",
        "text": "Let me give you the version I actually believe. Managing the risk of being wrong in public is its own discipline. I've watched this pattern hold across three different teams.",
        "timestamp_end_ms": 42000,
        "timestamp_start_ms": 36000,
        "transcript_ref": "transcripts/p08_e04.txt"
      },
      "type": "Quote"
    }
  ],
