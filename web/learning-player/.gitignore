node_modules/
dist/
dist-ssr/
.env.local
*.local

# Real mobile build-args (internal DSN/Umami/API URLs) — committed as .env.mobile.example
.env.mobile
.env.mobile.testflight

# Playwright outputs
test-results/
playwright-report/

# Vitest coverage
coverage/

# Vite
.vite/

# e2e per-user runtime state — the API server writes queue/profile/interest files
# here (APP_DATA_DIR, set in playwright.config.ts). The corpus itself is the
# COMMITTED tests/fixtures/app-validation-corpus/v2; only this mutable overlay is
# ephemeral, so it stays out of the committed tree and out of git.
e2e/.app-state/

# Tier-4 telemetry run artifacts (#2263). Same class of leak as `e2e/.app-state/` above: per-user
# state the API writes under APP_DATA_DIR, plus the Playwright JSON report the config emits. A
# `.handles.lock` from this tier was committed once before these rules existed.
e2e/.telemetry-state/
e2e/telemetry/.report.json
e2e/telemetry/.diag/

# ML model caches (whisper/transformers) pulled by any local pipeline run — never commit
.cache/

# Generated on every build by scripts/third-party.mjs (Settings › Third-party software).
public/third-party.json
