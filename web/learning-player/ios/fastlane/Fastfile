# Learning Player — iOS lanes.
#
# Run from `web/learning-player/ios`:
#
#   bundle install                 # once
#   bundle exec fastlane beta      # archive + upload to TestFlight (of whatever is CURRENTLY
#                                  #   synced into ios/App — this lane does NOT rebuild the web bundle)
#
# Prefer `make ios-testflight` from the repo root: it rebuilds the web bundle from
# .env.mobile.testflight, `npx cap sync`s it into ios/, THEN runs this lane. Invoking
# `fastlane beta` directly can ship a stale bundle.
#
# ## Credentials
#
# Authentication uses an App Store Connect API KEY, not an Apple ID + password. The key is a
# machine credential: it does not prompt for 2FA, does not expire when a human changes their
# password, and can be scoped to App Manager rather than Account Holder. Create one at
# App Store Connect → Users and Access → Integrations → App Store Connect API.
#
# Set these in the environment (see fastlane/.env.example — gitignored):
#
#   ASC_KEY_ID          the key's Key ID          (e.g. A1B2C3D4E5)
#   ASC_ISSUER_ID       the issuer UUID shown above the key list
#   ASC_KEY_PATH        path to the downloaded AuthKey_<KEY_ID>.p8
#   APPLE_TEAM_ID       your 10-char Developer Team ID
#
# The .p8 is downloadable EXACTLY ONCE from App Store Connect. Store it outside the repo (the
# gitignore covers *.p8 as a backstop, not as the plan).
#
# ## Signing
#
# This uses automatic signing (CODE_SIGN_STYLE = Automatic in project.pbxproj) with
# `xcodes`-free local certificates — i.e. whatever your Xcode is already signed into. That is the
# right default for a solo developer on their own laptop and needs no Match repo. If this ever
# moves to CI, switch to `match` or `app_store_connect_api_key` + `sync_code_signing`; the
# credential wiring below already supports it.

default_platform(:ios)

APP_DIR = File.expand_path("..", __dir__)          # web/learning-player/ios
WORKSPACE = File.join(APP_DIR, "App", "App.xcworkspace")
SCHEME = "App"

platform :ios do
  # --- helpers ---------------------------------------------------------------

  # Load the ASC API key, failing with a message that says exactly what is missing rather than a
  # stack trace from deep inside fastlane. A half-configured credential is the most common way
  # this lane fails, so it is checked up front.
  def asc_key
    missing = %w[ASC_KEY_ID ASC_ISSUER_ID ASC_KEY_PATH].reject { |k| ENV[k].to_s.strip != "" }
    unless missing.empty?
      UI.user_error!(
        "Missing App Store Connect credentials: #{missing.join(', ')}.\n" \
        "Copy fastlane/.env.example to fastlane/.env and fill it in, or export the vars.\n" \
        "Create a key at App Store Connect -> Users and Access -> Integrations."
      )
    end
    key_path = File.expand_path(ENV["ASC_KEY_PATH"])
    unless File.exist?(key_path)
      UI.user_error!("ASC_KEY_PATH points at #{key_path}, which does not exist. " \
                     "The .p8 is downloadable only once — check where you saved it.")
    end
    app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_filepath: key_path,
      in_house: false,
    )
  end

  # The Team ID the app-store archive signs under. Automatic signing (CODE_SIGN_STYLE = Automatic)
  # picks NO team on its own headlessly, so `xcodebuild archive` fails with "Signing requires a
  # development team" unless DEVELOPMENT_TEAM is supplied. Fail fast with a clear message rather
  # than after the archive starts.
  def team_id
    id = ENV["APPLE_TEAM_ID"].to_s.strip
    UI.user_error!(
      "APPLE_TEAM_ID is unset. Add it to fastlane/.env (see .env.example) — it is the 10-char\n" \
      "Team ID of the Apple Distribution cert, e.g. `security find-identity -v -p codesigning`."
    ) if id.empty?
    id
  end

  # --- lanes -----------------------------------------------------------------

  desc "Verify the App Store Connect credentials + workspace (no signing check, build, or upload)."
  desc "Run this first on a new machine — it fails in seconds instead of after a 10-minute build."
  lane :preflight do
    asc_key
    UI.success("App Store Connect key loads and the .p8 is readable.")
    UI.message("Team: #{ENV['APPLE_TEAM_ID'] || '(unset — Xcode will pick, which may be wrong)'}")
    UI.message("Workspace: #{WORKSPACE}")
    UI.user_error!("Workspace not found — run `npx cap sync ios` first.") unless File.exist?(WORKSPACE)
    UI.success("Workspace present. Ready for `bundle exec fastlane beta`.")
  end

  desc "Build a DEVELOPMENT-signed IPA for a direct on-device install (devicectl) — no upload."
  desc "Use while iterating on a fix you want to try on your own phone before it goes to TestFlight."
  lane :device do
    team = team_id
    # Development export (not app-store): re-signs for a dev provisioning profile that embeds this
    # team's registered devices, so the IPA sideloads via `xcrun devicectl device install app`.
    # -allowProvisioningUpdates + the ASC key let Xcode mint/refresh that profile headlessly (this
    # machine has no signed-in Xcode account). This does NOT need the App Store distribution
    # permission the TestFlight `beta` export requires.
    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      # DEBUG, not Release. The Debug configuration is what a development build actually is:
      # automatic signing, `APS_ENVIRONMENT = development`, the muted `AppIcon-Internal`, and its
      # own bundle id `app.closelistening.player.dev`. Release now pins manual distribution signing
      # and a production APNs environment for TestFlight, so asking it for a `development` export
      # was self-contradictory — it would sign with the distribution identity and then try to
      # export against a development profile.
      #
      # The separate bundle id is the point: iOS identifies an app by bundle id alone, so a dev
      # build sharing `app.closelistening.player` REPLACES the TestFlight one on the home screen
      # rather than sitting beside it (operator hit exactly this, 2026-09-30). Different id =
      # both installed, and the muted icon plus the "CL Dev" name say which is which.
      configuration: "Debug",
      export_method: "development",
      output_directory: File.join(APP_DIR, "build"),
      output_name: "App-dev.ipa",
      clean: true,
      # Bundle id, icon and display name all come from the Debug configuration now — one source of
      # truth in the project rather than settings the lane reapplies and Xcode does not.
      xcargs: "-allowProvisioningUpdates " \
              "-authenticationKeyID #{ENV['ASC_KEY_ID']} " \
              "-authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']} " \
              "-authenticationKeyPath \"#{File.expand_path(ENV['ASC_KEY_PATH'])}\" " \
              "DEVELOPMENT_TEAM=#{team}",
      export_options: { teamID: team, signingStyle: "automatic" },
    )
    UI.success(
      "Dev IPA: #{File.join(APP_DIR, 'build', 'App-dev.ipa')}\n" \
      "Install: xcrun devicectl device install app --device <UDID> #{File.join(APP_DIR, 'build', 'App-dev.ipa')}"
    )
  end

  # Manual signing for release archives (2026-09-30).
  #
  # Automatic signing cannot archive on this machine: it wants a DEVELOPMENT certificate for the
  # team, this account has none, and Xcode's offer is to create one "after revoking your existing
  # certificate" — which would break the operator's laptop. Manual signing with the distribution
  # certificate and an explicit profile sidesteps that, and is what fastlane `match` does for the
  # same reason.
  #
  # The profile is created + installed by scripts/tools (ASC API); the key has permission to manage
  # signing assets, verified by creating one.
  PROFILE_NAME = "Close Listening Player AppStore"

  # The TestFlight group builds are handed to. Internal: no Beta App Review, available to
  # testers as soon as processing finishes (5-15 min), capped at 100 App Store Connect users.
  INTERNAL_GROUP = "Internal Testers"

  def signing_xcargs(team)
    "-allowProvisioningUpdates " \
    "-authenticationKeyID #{ENV['ASC_KEY_ID']} " \
    "-authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']} " \
    "-authenticationKeyPath \"#{File.expand_path(ENV['ASC_KEY_PATH'])}\" " \
    "DEVELOPMENT_TEAM=#{team}"
    # Manual signing lives in the APP TARGET's Release config, not here. Passed as xcargs it
    # applies to EVERY target including the Pods frameworks, which reject it outright:
    # "CapacitorApp does not support provisioning profiles". Frameworks are signed by the app that
    # embeds them, so only the app target may name a profile.
  end

  def signing_export_options(team)
    {
      teamID: team,
      signingStyle: "manual",
      provisioningProfiles: { "app.closelistening.player" => PROFILE_NAME },
      # Xcode must NOT rewrite the build number behind the lane's back.
      #
      # This option defaults to TRUE for app-store exports: Xcode queries App Store Connect during
      # `-exportArchive` and silently replaces CFBundleVersion with "latest TestFlight build + 1".
      # It does work — but it means the archive and the exported .ipa disagree. Measured on
      # 2026-09-30: the archive was build 1, the .ipa it produced was build 2. The dSYM is filed
      # under the archive's number while crashes report the .ipa's, and any log line saying which
      # build was made is wrong.
      #
      # Off, the number the lane derived is the number that archives, exports, ships and appears in
      # TestFlight — one value, decided in one place, printed in the lane output.
      # CAMEL CASE, deliberately. gym has no option of this name, so it copies the key into the
      # generated exportOptions plist verbatim — and Xcode only reads
      # `manageAppVersionAndBuildNumber`. Written snake_case it is accepted by fastlane,
      # printed in the lane summary, written to the plist, and ignored by Xcode: the export
      # still renumbered the build (verified 2026-09-30 — archive 1, ipa 2, twice).
      manageAppVersionAndBuildNumber: false,
    }
  end

  desc "Everything `beta` does EXCEPT the upload — archive, export a signed app-store .ipa, stop."
  desc "Use this to prove the pipeline works without putting a build in front of testers."
  lane :validate do
    api_key = asc_key
    team = team_id

    # No build-number bump. `beta` derives the next number from TestFlight and INCREMENTS the
    # project file; doing that for a dry run would burn a number and leave the project dirty on a
    # lane that ships nothing.
    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: File.join(APP_DIR, "build"),
      output_name: "App-validate.ipa",
      clean: true,
      xcargs: signing_xcargs(team),
      export_options: signing_export_options(team),
    )

    ipa = File.join(APP_DIR, "build", "App-validate.ipa")
    UI.success("Signed app-store IPA: #{ipa} (#{(File.size(ipa) / 1_048_576.0).round(1)} MB)")
    UI.important("NOT uploaded. `fastlane beta` is the lane that ships.")
    # Prove WHICH identity signed it. A dev-signed archive exports with confusing 403s rather than
    # an obvious error, which cost a debugging cycle on 2026-09-30 — so this says it out loud.
    sh("unzip -p '#{ipa}' 'Payload/*.app/embedded.mobileprovision' | " \
       "security cms -D 2>/dev/null | plutil -extract Name raw - || true")
  end

  desc "Build a signed release archive and upload it to TestFlight."
  lane :beta do
    api_key = asc_key
    team = team_id

    # The build number must be unique per upload or App Store Connect rejects the build AFTER the
    # whole archive has uploaded. Deriving it from the latest TestFlight build means you never
    # have to remember to bump anything, and a re-run after a failure does not collide.
    latest = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "app.closelistening.player",
      initial_build_number: 0,
    )
    build_number = (latest + 1).to_s
    UI.message("Building build number #{build_number} (previous TestFlight build: #{latest}).")
    # The number is passed to xcodebuild as a build SETTING, not written into the project.
    #
    # `increment_build_number` shells out to agvtool, which rewrites Info.plist in place and
    # replaces `$(CURRENT_PROJECT_VERSION)` with the literal number. After one run the plist no
    # longer interpolates anything, so EVERY later build ships that same number and App Store
    # Connect rejects the upload as a duplicate — after the whole archive has already uploaded.
    # Observed on the first real ship, 2026-09-30: build 1 was hardcoded into the plist.
    #
    # Overriding the setting leaves the repo untouched and still derives the number from
    # TestFlight, so a re-run after a failure cannot collide either.

    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: File.join(APP_DIR, "build"),
      clean: true,
      # Automatic signing needs the team on the archive itself (a build setting, not an export
      # option). -allowProvisioningUpdates lets Xcode mint the app-specific App Store profile
      # (including the app's Push capability), and the -authenticationKey* flags authenticate that
      # update via the ASC API key — Xcode has no signed-in account on this machine, so without
      # them xcodebuild errors "No Accounts" and falls back to a wildcard profile. gym itself has
      # no api_key option, hence passing the credential through to xcodebuild directly here.
      xcargs: "#{signing_xcargs(team)} CURRENT_PROJECT_VERSION=#{build_number}",
      export_options: signing_export_options(team),
    )

    upload_to_testflight(
      api_key: api_key,
      # No Beta App Review: internal testers get the build as soon as Apple finishes processing.
      distribute_external: false,
      # AND say so explicitly. `distribute_external: false` alone is not enough: fastlane's
      # `submit_beta_review` defaults to TRUE, so it still POSTed a beta-app-review submission for
      # an internal-only build. App Store Connect refused it ("Beta App Description is missing" —
      # the app has none, because it has never had external testers), and the lane died BEFORE
      # adding the build to the group. Build 2 (2026-10-04) was processed, valid and reached
      # nobody until it was attached to "Internal Testers" by hand through the API.
      submit_beta_review: false,
      # Hand the build to the internal group, so it is installable rather than merely uploaded.
      groups: [INTERNAL_GROUP],
      changelog: "Build #{build_number} from #{git_branch} (#{last_git_commit[:abbreviated_commit_hash]}).",

      # WAIT for processing (the default), even though it costs 5-15 minutes of lane time.
      #
      # `skip_waiting_for_build_processing: true` returns the moment the bytes are uploaded — and
      # a build that has not finished processing CANNOT be assigned to a group, so fastlane
      # silently drops `groups:` and `changelog:`. The lane prints "Uploaded" and "finished
      # successfully", Apple validates the build, and it reaches nobody: testers open TestFlight
      # and see an empty list. Exactly that happened on the first real ship (2026-09-30, build 1),
      # which had to be attached to the group by hand through the API afterwards.
      #
      # Waiting is what makes the lane a RELEASE rather than an upload. Unattended automation is
      # the whole point here, and an unattended run that needs someone to finish it by hand is
      # worse than a slow one.
      skip_waiting_for_build_processing: false,
    )

    UI.success(
      "Uploaded. It appears in TestFlight after Apple finishes processing (usually 5–15 min). " \
      "Internal testers get it with no review."
    )
  end
end
