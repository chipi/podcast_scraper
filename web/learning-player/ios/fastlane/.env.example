# App Store Connect credentials for `bundle exec fastlane beta`.
#
# Copy to `fastlane/.env` and fill in. That file is gitignored; this .example is committed.
# fastlane loads fastlane/.env automatically, so you do not need to export anything by hand.
#
# Create the key: App Store Connect -> Users and Access -> Integrations -> App Store Connect API
# -> "+". Give it the "App Manager" role; "Admin" is more than TestFlight uploads need.

# The Key ID shown in the key list (10 chars).
ASC_KEY_ID=

# The Issuer ID shown ABOVE the key list — one UUID for the whole team, not per key.
ASC_ISSUER_ID=

# Absolute path to the AuthKey_<KEY_ID>.p8 you downloaded.
#
# Apple lets you download it EXACTLY ONCE. Keep it outside the repo — e.g. ~/.appstoreconnect/ —
# and back it up. If it is lost the key must be revoked and a new one created.
ASC_KEY_PATH=/Users/you/.appstoreconnect/AuthKey_XXXXXXXXXX.p8

# Your Apple Developer Team ID (10 chars). developer.apple.com/account -> Membership details.
# Not a secret, but it belongs with the rest of the config.
APPLE_TEAM_ID=

# Only needed if your Apple ID belongs to more than one App Store Connect team.
APPLE_ITC_TEAM_ID=
