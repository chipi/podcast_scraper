# Mobile build-args for the Capacitor shells (iOS + Android).
#
# Copy this file to `.env.mobile` (gitignored) and fill in your REAL values.
# `.env.mobile` holds internal/prod URLs and must NEVER be committed.
#
# Consumed by `make mobile-build-internal` / `make mobile-build-release`, which
# source this file and export the vars before `npm run build && npx cap sync`.
# All `VITE_*` vars are baked into the JS bundle at build time (client-visible by
# design — DSN/website-id are public browser ids, not secrets); the URLs they
# point at are the only sensitive part, which is why the real file stays local.

# Prod GlitchTip/Sentry DSN — the PUBLIC ingest edge (a browser client can't reach
# the tailnet-only backend). Empty => no error reporting. `make mobile-build-release`
# FAILS if this is empty, so a shipped app can never silently lose crash reporting.
VITE_SENTRY_DSN_PLAYER=

# Umami analytics (cookieless). Both required to enable; empty => no-op.
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_SRC=

# Absolute API base for native builds (web uses the origin-relative default).
# e.g. https://api.your-domain.example/api/app
VITE_API_BASE_URL=

# The DEV tier's api base, used when the in-app tier switch is set to "dev".
#
# This used to be hardcoded in src/services/tier.ts as the developer's own tailnet host. That is a
# personal machine name: it tripped the operator identifier deny-list and baked a private hostname
# into every bundle, so it now lives here (this file is gitignored; only .example is committed).
#
# NORMALLY LEAVE THIS EMPTY. The build derives the tailnet base from the machine you build ON
# (vite.config.ts § resolveDevApiBase), so a physical device works with no configuration from
# either dev machine, and the simulator falls back to http://127.0.0.1:8080/api/app.
#
# Set it only when you build on one machine and serve the dev API from another:
#   e.g. VITE_DEV_API_BASE=https://<your-machine>.<tailnet>.ts.net/api/app
# `tailscale serve` fronts that host so iOS ATS gets a real HTTPS cert with no cleartext exception.
VITE_DEV_API_BASE=

# Coming-soon gate credential for the native PROD tier (internal builds only). While the site is
# pre-launch, closelistening.app gates /api/app/* behind a secret cookie; the edge (player.caddy
# @authed) also accepts a valid HTTP Basic-auth header. Bake the base64 of "user:pass" here so the
# native app's prod tier can reach the gated API. Generate with:
#   printf '%s' 'marko:YOUR_PREVIEW_PASSWORD' | base64
# Empty => prod tier hits the coming-soon page (dev/laptop tier is unaffected). Tree-shaken from
# release builds (the tier switch is prod-locked there, so this is never baked into a shipped app).
VITE_PREVIEW_BASIC_AUTH=

# Coming-soon gate COOKIE value (native prod tier, internal builds only). Preferred over the Basic
# header above because it doesn't collide with a signed-in user's `Authorization: Bearer` — caddy's
# @preview_ok matches the cookie before @authed. The app seeds it into the native cookie jar at
# startup (services/native.ts :: initGateCookie). Get the value from the /preview handshake:
#   curl -s -i -u 'marko:YOUR_PREVIEW_PASSWORD' https://closelistening.app/preview | grep -i set-cookie
# then copy the cl_preview=<value> token (the <value> part only).
VITE_PREVIEW_COOKIE=

# --- Dev-tier on-device o11y (optional) ---
# The committed dev defaults are plain-http to `homelab`, which a native WebView
# blocks (https origin -> http). To get dev-tier errors/analytics on a real device,
# expose GlitchTip/Umami over https on the tailnet via `tailscale serve` and set the
# resulting https URLs here (host/port/path depend on your serve topology).
#   e.g. VITE_SENTRY_DSN_PLAYER_DEV=https://<key>@homelab.<tailnet>.ts.net/glitchtip/8
#        VITE_UMAMI_SRC_DEV=https://homelab.<tailnet>.ts.net/umami/script.js
VITE_SENTRY_DSN_PLAYER_DEV=
VITE_UMAMI_SRC_DEV=
