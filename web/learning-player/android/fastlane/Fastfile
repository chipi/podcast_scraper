# Learning Player — Android lanes (#2192).
#
# Run from `web/learning-player/android`:
#
#   bundle install                     # once
#   bundle exec fastlane preflight     # verify credentials + the Play app record; builds nothing
#   bundle exec fastlane internal      # upload the CURRENT AAB to the internal testing track
#
# Prefer `make android-play` from the repo root: it rebuilds the web bundle from
# .env.mobile.testflight, `npx cap sync`s it, produces a SIGNED release AAB, and only then runs
# this lane. Invoking `fastlane internal` directly uploads whatever AAB happens to be on disk,
# which may be stale or may not exist.
#
# Deliberately mirrors ios/fastlane: a `preflight` that fails in seconds rather than after a
# multi-minute build, and one upload lane per test channel. Two platforms operated the same way is
# worth more than each being idiomatic on its own.
#
# ## Credentials
#
# A Google Play SERVICE ACCOUNT JSON, not a human login — the same reasoning as the iOS App Store
# Connect API key: a machine credential does not prompt, does not expire with someone's password,
# and can be scoped.
#
#   Google Cloud console → the project linked to Play → IAM → Service accounts → create → keys →
#   JSON. Then Play Console → Users and permissions → invite that service account and grant it
#   "Release to testing tracks" (do NOT grant production release rights for this).
#
# Set in the environment (see fastlane/.env.example — gitignored):
#
#   SUPPLY_JSON_KEY     absolute path to the downloaded service-account .json
#
# The JSON is a secret. Store it outside the repo; the gitignore covers *.json under fastlane/ as
# a backstop, not as the plan.
#
# ## The first upload cannot come from here
#
# Play will not accept an API upload for a package it has never seen. The FIRST artifact for
# `app.closelistening.player` has to be uploaded by hand in the Play Console, once. Every upload
# after that can use this lane. `preflight` says so explicitly rather than letting the first
# `internal` run fail with an opaque 404.

default_platform(:android)

APP_DIR = File.expand_path("..", __dir__)          # web/learning-player/android
PACKAGE = "app.closelistening.player"
AAB = File.join(APP_DIR, "app", "build", "outputs", "bundle", "release", "app-release.aab")

platform :android do
  # --- helpers ---------------------------------------------------------------

  def json_key
    path = ENV["SUPPLY_JSON_KEY"].to_s
    UI.user_error!(
      "SUPPLY_JSON_KEY is not set.\n" \
      "  Copy fastlane/.env.example to fastlane/.env and point it at the Play service-account " \
      "JSON.\n" \
      "  See the header of this Fastfile for how to create one."
    ) if path.empty?
    expanded = File.expand_path(path)
    UI.user_error!("No Play service-account JSON at #{expanded}") unless File.exist?(expanded)
    expanded
  end

  # --- lanes -----------------------------------------------------------------

  desc "Print the next free versionCode for the internal track, and nothing else."
  desc "Consumed by `make android-play`, which exports it into the gradle build."
  lane :next_version_code do
    # WHY THIS EXISTS
    #
    # `build.gradle` derives versionCode from `git rev-list --count HEAD` when the env var is
    # absent. That is monotonic on ONE branch and nowhere else. Measured 2026-09-30: `beta-users`
    # was 1484 while `origin/main` was 1468, because recent main history is squash merges. So an
    # upload from a feature branch burns 1484, the squash-merge makes main 1469, and the next
    # release from main is REJECTED for going backwards — after the whole AAB has uploaded. Two
    # worktrees collide the same way.
    #
    # Play itself is the only authority on "what have we already used", exactly as
    # `latest_testflight_build_number` is on iOS.
    #
    # Printed as a LABELLED line (fastlane prefixes even `puts` with a timestamp, so the Makefile
    # takes only the digits after `NEXT_VERSION_CODE=`). fastlane writes its own lines to
    # stdout after this one, so "the last line" is the run summary — and stripping that to digits
    # turned the timestamp and ANSI colour codes into versionCode 115305320 on the first real run
    # (2026-10-04, stopped before upload). Play never lowers a versionCode, so that upload would
    # have pushed every future one above 115 million.
    codes = google_play_track_version_codes(
      package_name: PACKAGE,
      track: "internal",
      json_key: json_key,
    )
    next_code = (codes.max || 0) + 1
    UI.message("internal track has #{codes.inspect}; next is #{next_code}")
    puts "NEXT_VERSION_CODE=#{next_code}"
  end

  desc "Download Play's SIGNED universal APK for a build (default: the latest on internal)."
  desc "For a tester Play will not serve yet ('Item not found'): install the file directly."
  lane :universal_apk do |options|
    # WHY THIS EXISTS (2026-10-07)
    #
    # A newly added tester accepted the invite and Play answered "Item not found" until his access
    # propagated. Internal app sharing is not available — the API refuses with NOT_PUBLISHED while
    # the app has never been published. Play itself can hand out the universal APK it generates
    # from the uploaded bundle, signed with the Play APP-SIGNING key — the same key every Play
    # install carries — so a tester can sideload it now and Play later updates it in place.
    code = (options[:version_code] || ENV["VERSION_CODE"]).to_s.strip
    if code.empty?
      codes = google_play_track_version_codes(package_name: PACKAGE, track: "internal", json_key: json_key)
      UI.user_error!("The internal track has no build.") if codes.empty?
      code = codes.max.to_s
    end
    UI.user_error!("version_code must be a number, got #{code.inspect}") unless code.match?(/\A\d+\z/)

    require "supply"
    Supply.config = FastlaneCore::Configuration.create(
      Supply::Options.available_options, { package_name: PACKAGE, json_key: json_key }
    )
    service = Supply::Client.make_from_config.instance_variable_get(:@client)
    generated = service.list_generatedapks(PACKAGE, code.to_i).generated_apks || []
    universal = generated.map(&:generated_universal_apk).compact.first
    UI.user_error!("Play has no universal APK for versionCode #{code} (yet).") unless universal

    out_dir = File.join(APP_DIR, "app", "build", "outputs", "play")
    FileUtils.mkdir_p(out_dir)
    out = File.join(out_dir, "close-listening-#{code}-universal.apk")
    service.download_generatedapk(PACKAGE, code.to_i, universal.download_id, download_dest: out)
    UI.success("Saved #{out} (#{(File.size(out) / 1_048_576.0).round(1)} MB)")
    puts "UNIVERSAL_APK=#{out}"
  end

  desc "Read-only: what the internal track holds, and whether Play has PROCESSED a build yet."
  lane :status do |options|
    # WHY THIS EXISTS (2026-10-09)
    #
    # "Uploaded" and "completed" on the track are not "a tester can install it": on 2026-10-07 the
    # build was published and not installable for about half an hour. Play generates the signed
    # APKs from the bundle when it has processed it, and `generatedapks.list` answers only then —
    # the closest signal the API gives. It is still not proof: the proof is a tester's phone
    # offering the update (Play Store -> Manage apps & device -> Updates).
    #
    # Reads only. The edit opened to read the track is deleted, never committed.
    require "supply"
    Supply.config = FastlaneCore::Configuration.create(
      Supply::Options.available_options, { package_name: PACKAGE, json_key: json_key }
    )
    service = Supply::Client.make_from_config.instance_variable_get(:@client)
    edit = service.insert_edit(PACKAGE)
    begin
      track = service.get_edit_track(PACKAGE, edit.id, "internal")
      (track.releases || []).each do |r|
        puts "TRACK internal: #{r.name} status=#{r.status} versionCodes=#{(r.version_codes || []).join(',')}"
      end
      codes = (track.releases || []).flat_map { |r| (r.version_codes || []).map(&:to_i) }
    ensure
      service.delete_edit(PACKAGE, edit.id)
    end

    code = (options[:version_code] || ENV["VERSION_CODE"]).to_s.strip
    code = codes.max.to_s if code.empty?
    UI.user_error!("The internal track has no build.") if code.empty?
    # For a versionCode Play has not processed (or does not know) the API raises a ClientError
    # rather than answering with an empty list; that IS the "not yet" answer.
    begin
      generated = service.list_generatedapks(PACKAGE, code.to_i).generated_apks || []
      processed = generated.any? { |g| g.generated_universal_apk }
      puts "PROCESSED versionCode=#{code}: #{processed ? 'yes — Play has generated its APKs' : 'not yet'}"
    rescue Google::Apis::ClientError => e
      puts "PROCESSED versionCode=#{code}: not yet (Play: #{e.message})"
    end
    puts "PROOF it is installable: a tester's Play Store -> Manage apps & device -> Updates offers it."
  end

  desc "Verify the Play credentials + that the app record exists (no build, no upload)."
  desc "Run this first on a new machine — it fails in seconds instead of after a build."
  lane :preflight do
    key = json_key
    # `validate_play_store_json_key` proves the credential parses and authenticates. It does NOT
    # prove the service account can see OUR app, which is the other half of the usual failure, so
    # the track read below does that.
    validate_play_store_json_key(json_key: key)
    UI.success("Play service-account JSON authenticates.")

    begin
      codes = google_play_track_version_codes(
        package_name: PACKAGE,
        track: "internal",
        json_key: key,
      )
      UI.success("App record found. internal track version codes: #{codes.inspect}")
      UI.message("Next upload will be versionCode #{(codes.max || 0) + 1} or higher.")
    rescue StandardError => e
      UI.error("Could not read the internal track for #{PACKAGE}.")
      UI.error("Two things cause this, and they need different fixes:")
      UI.error("  1. The app record does not exist yet, or has never had a manual first upload.")
      UI.error("     Play refuses API uploads for a package it has never seen — do ONE upload by")
      UI.error("     hand in the Play Console, then this lane works forever after.")
      UI.error("  2. The service account is not invited to this app, or lacks release permission.")
      UI.error("Underlying error: #{e.message}")
      raise
    end
  end

  desc "Upload the current signed AAB to the internal testing track."
  lane :internal do
    key = json_key
    UI.user_error!(
      "No AAB at #{AAB}.\n" \
      "  Build one first: `make android-bundle` from the repo root (it also proves the bundle " \
      "carries this web build and targets a hosted api)."
    ) unless File.exist?(AAB)

    UI.message("Uploading #{File.basename(AAB)} (#{(File.size(AAB) / 1_048_576.0).round(1)} MB)")
    upload_to_play_store(
      package_name: PACKAGE,
      json_key: key,
      aab: AAB,
      track: "internal",
      # The only listing asset in fastlane/metadata is the icon (see `listing_icon`); there is no
      # text, screenshots or changelogs, and supply would otherwise try to sync (and could CLEAR)
      # what is in the console. Uploading a binary must not be able to rewrite the store listing
      # as a side effect.
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      skip_upload_changelogs: true,
      # Internal testers get it immediately; there is no staged rollout on this track.
      release_status: "completed",
    )
    UI.success("Uploaded to the internal testing track.")
  end

  desc "Set the Play listing's app icon (512x512) and nothing else."
  # The listing icon is a store asset, not the launcher icon inside the AAB: Play showed none
  # because nothing ever uploaded one (operator 2026-10-07). The file is the iOS 1024 AppIcon
  # scaled to 512, so both stores show the same mark. Changes the PUBLIC listing — run it on
  # purpose, never as part of a build.
  lane :listing_icon do
    icon = File.join(APP_DIR, "fastlane", "metadata", "android", "en-US", "images", "icon.png")
    UI.user_error!("No listing icon at #{icon}.") unless File.exist?(icon)
    # The Play client directly, not `upload_to_play_store`: with every binary skipped, supply still
    # looks for a release to attach to and fails ("Could not find release for version code ''",
    # 2026-10-07) before uploading anything. One edit: replace the icon, commit, nothing else.
    require "supply"
    Supply.config = FastlaneCore::Configuration.create(
      Supply::Options.available_options, { package_name: PACKAGE, json_key: json_key }
    )
    client = Supply::Client.make_from_config
    client.begin_edit(package_name: PACKAGE)
    client.clear_screenshots(image_type: "icon", language: "en-US")
    client.upload_image(image_path: icon, image_type: "icon", language: "en-US")
    client.commit_current_edit!
    UI.success("Listing icon uploaded (en-US).")
  end
end
